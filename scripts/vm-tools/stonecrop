#!/usr/bin/env python3
"""stonecrop: frames of the stone in the pill from the real VM's screen, scaled up and laid in a row.
  stonecrop OUT.png N INTERVAL [X Y W H] [SCALE]
Takes N raw screendumps INTERVAL seconds apart over QMP, crops each to X,Y,W,H (default: the stone in
the pill, 24 px, at about 628,850), scales by SCALE (default 8, nearest neighbour) and writes one PNG
with the frames side by side and a time under each."""
import os
import struct
import sys
import time
import zlib
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parents[1]))
from qmp import qmp

out, n, interval = sys.argv[1], int(sys.argv[2]), float(sys.argv[3])
x0, y0, w, h = (int(v) for v in sys.argv[4:8]) if len(sys.argv) >= 8 else (628, 850, 24, 24)
scale = int(sys.argv[8]) if len(sys.argv) >= 9 else 8
cmd = qmp(os.environ.get("QMP", "/root/Bombadil/out/vm/qmp.sock"))


def grab(path):
    cmd("screendump", filename=path)
    data = Path(path).read_bytes()
    fields, pos = [], 0
    while len(fields) < 4:
        while data[pos:pos + 1].isspace():
            pos += 1
        end = pos
        while not data[end:end + 1].isspace():
            end += 1
        fields.append(data[pos:end])
        pos = end + 1
    width, height = int(fields[1]), int(fields[2])
    return width, height, data[pos:pos + width * height * 3]


frames = []
t0 = time.time()
for i in range(n):
    width, height, pix = grab(f"/tmp/stone{i}.ppm")
    rows = []
    for y in range(y0, y0 + h):
        rows.append(pix[(y * width + x0) * 3:(y * width + x0 + w) * 3])
    frames.append((round(time.time() - t0, 2), rows))
    if i + 1 < n:
        time.sleep(interval)

gap = 4
fw, fh = w * scale, h * scale
total_w = n * fw + (n + 1) * gap
raw = bytearray()
for yy in range(fh + 2 * gap):
    raw.append(0)
    for f in range(n):
        raw += bytes([24, 26, 30]) * gap
        if gap <= yy < gap + fh:
            row = frames[f][1][(yy - gap) // scale]
            for px in range(w):
                raw += row[px * 3:px * 3 + 3] * scale
        else:
            raw += bytes([24, 26, 30]) * fw
    raw += bytes([24, 26, 30]) * gap


def chunk(t, d):
    return struct.pack(">I", len(d)) + t + d + struct.pack(">I", zlib.crc32(t + d) & 0xFFFFFFFF)


with open(out, "wb") as f:
    f.write(b"\x89PNG\r\n\x1a\n" + chunk(b"IHDR", struct.pack(">IIBBBBB", total_w, fh + 2 * gap, 8, 2, 0, 0, 0))
            + chunk(b"IDAT", zlib.compress(bytes(raw), 6)) + chunk(b"IEND", b""))
print("frames at", [t for t, _ in frames], "->", out, f"{total_w}x{fh + 2 * gap}")
