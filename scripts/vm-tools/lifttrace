#!/usr/bin/env python3
"""lifttrace OUT DURATION INTERVAL: the stone's top row in the pill (y) and the first grey row at x=352
(the pill or the card above it) over time, from QMP screendumps, to see whether the pill moves when a
card changes size. The socket is $QMP, else out/vm/qmp.sock. Rest is about y=853 on a 1600x900 screen."""
import os
import sys
import time
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parents[1]))
from qmp import qmp

out, dur, iv = sys.argv[1], float(sys.argv[2]), float(sys.argv[3])
cmd = qmp(os.environ.get("QMP") or str(Path(__file__).resolve().parents[2] / "out" / "vm" / "qmp.sock"))
COL = [(217, 119, 87), (95, 179, 107), (224, 169, 59)]
rows = []
t0 = time.time()
while time.time() - t0 < dur:
    t = time.time() - t0
    cmd("screendump", filename="/tmp/lt.ppm")
    d = Path("/tmp/lt.ppm").read_bytes()
    parts = d.split(None, 4); w, h = int(parts[1]), int(parts[2]); pix = d[len(d) - w * h * 3:]
    # the stone in the pill (green at rest, orange when working): its top row
    top = None
    for y in range(600, 900):
        base = y * w * 3
        if any(abs(pix[base + x * 3] - c[0]) < 14 and abs(pix[base + x * 3 + 1] - c[1]) < 14 and abs(pix[base + x * 3 + 2] - c[2]) < 14
               for x in range(368, 384) for c in ((95, 179, 107), (217, 119, 87))):
            top = y; break
    card = None
    for y in range(300, 900):
        o = (y * w + 352) * 3
        if pix[o] > 14 and pix[o] < 60 and abs(pix[o] - pix[o + 2]) < 20:
            card = y; break
    rows.append((round(t, 2), top, card))
    time.sleep(max(0, iv - 0.02))
Path(out).write_text("\n".join(f"{t} {top} {card}" for t, top, card in rows))
print(len(rows), "samples ->", out)
