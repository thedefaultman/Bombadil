#!/usr/bin/env python3
"""Start the mail service from a checkout, the way bin/agentd starts agentd."""

import sys
from pathlib import Path

# The path is set before the package import on purpose: from a checkout `bombadil` is not installed.
sys.path.insert(0, str(Path(__file__).resolve().parents[1] / "src"))

from bombadil.mail.service import main

sys.exit(main())
