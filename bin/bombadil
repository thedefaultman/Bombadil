#!/usr/bin/env python3
"""bombadil: talk to agentd from a terminal, or manage the system.

  bombadil ask "open the browser"     send a prompt and stream the reply
  bombadil status                      is the agent busy, which provider
  bombadil stop                        end the running turn and everything it started
  bombadil pill                        give the pill the keyboard (Hyprland runs this on a Super tap)
  bombadil watch [--file F] [--follow] every step, command and output of the last (or a) turn
  bombadil history                     recent turns and launcher actions
  bombadil undo                        roll back the last turn (reboot to apply)
  bombadil provider claude|codex       switch provider (restart agentd to apply)
  bombadil brain [status]              what the brain knows, and whether it sees every save
  bombadil brain why PATH              who made a file, and when
  bombadil brain find WORDS            things whose names match: title · where · when
  bombadil brain focus PATH|URL|KEY    everything around one thing (turn:41, app:passwords, system)
  bombadil brain rebuild               forget the index and make it again from your files
                                       (add --json to any brain command for the whole answer)
"""
import json
import os
import re
import socket
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parents[1] / "src"))
from bombadil import config, paths, snapshots, watch  # noqa: E402


def talk(msg: dict, until: str | None = "turn_end"):
    with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as s:
        try:
            s.connect(str(paths.socket_path()))
        except OSError as e:
            print(f"agentd is not running ({e}); it starts with the Hyprland session", file=sys.stderr)
            return 1
        s.sendall((json.dumps(msg) + "\n").encode())
        mine = None  # the turn id agentd gave this prompt; other clients' turns are skipped
        for line in s.makefile("r"):
            ev = json.loads(line)
            if ev.get("type") == "status":
                if until == "status":
                    print(json.dumps(ev))
                    return 0
                continue
            if ev.get("type") == "queued":
                mine = ev["turn"]
                continue
            if ev.get("type") == "local":
                mine = "local"  # a launcher word: answered at once, no turn follows
                continue
            if mine == "local":
                if ev.get("kind") == "local" and ev.get("phase") == "done":
                    print(ev.get("text", ""), file=sys.stdout if ev.get("ok") else sys.stderr)
                    return 0 if ev.get("ok") else 1
                continue
            if ev.get("turn") is not None and ev.get("turn") != mine:
                continue
            if ev.get("kind") in ("text", "output"):
                print(ev["text"])
            elif ev.get("kind") == "tool":
                print(f"  [{ev['name']}] {json.dumps(ev.get('input', {}))[:120]}")
            elif ev.get("kind") == "error":
                print(f"error: {ev['text']}", file=sys.stderr)
                if ev.get("turn") is None:
                    return 1
            if ev.get("kind") == until:
                return 0
    return 0


def send(msg: dict) -> int:
    """Fire one message at agentd and return; for key binds, which must never hang."""
    with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as s:
        s.settimeout(2)
        try:
            s.connect(str(paths.socket_path()))
            s.sendall((json.dumps(msg) + "\n").encode())
            s.shutdown(socket.SHUT_WR)
        except OSError as e:
            print(f"agentd is not running ({e})", file=sys.stderr)
            return 1
        # Closing at once would make agentd's greeting fail and drop the line unread; it hangs
        # up once it has read it.
        try:
            while s.recv(65536):
                pass
        except OSError:
            pass
    return 0


def brain_ref(arg: str) -> str:
    """A path as typed (relative, ~) becomes absolute; links, ids and keys (turn:41) stay."""
    if not os.path.lexists(arg):
        if re.match(r"^[a-z][a-z0-9+.-]*:", arg) or arg.isdigit() or arg == "system":
            return arg
    return os.path.abspath(os.path.expanduser(arg))


def _slot_line(item: dict) -> str:
    why = item.get("why") or ""
    bits = [item.get("title") or item.get("name") or "", why]
    if item.get("when") and item["when"] not in why:
        bits.append(item["when"])
    return "  " + " · ".join(b for b in bits if b)


def focus_lines(f: dict) -> list[str]:
    """The Focus answer as a person reads it: the thing, where it came from, what goes with it."""
    thing = f.get("thing") or {}
    out = [thing.get("title") or thing.get("ref") or ""]
    if thing.get("path") or thing.get("url"):
        out.append(thing.get("path") or thing.get("url"))
    out += [thing[k] for k in ("made", "last") if thing.get(k)]
    d = f.get("description") or {}
    if d.get("text"):
        out.append(f"“{d['text']}”" + (" (out of date)" if d.get("stale") else ""))
    elif d.get("pending"):
        out.append("A description is being written.")
    slots = f.get("slots") or {}
    for key, name in (("came_from", "Came from"), ("read_with", "Read with"), ("used_with", "Used with")):
        slot = slots.get(key) or {}
        if slot.get("items"):
            out += ["", name] + [_slot_line(i) for i in slot["items"]]
            if slot.get("more"):
                out.append(f"  and {slot['more']} more")
    changes = slots.get("changes") or {}
    if changes.get("items"):
        out += ["", f"Changes ({changes.get('count_week') or 0} this week)"]
        out += [f"  {i.get('when') or ''} · {i.get('why') or ''}" for i in changes["items"]]
        if changes.get("more"):
            out.append(f"  and {changes['more']} more")
    kids = f.get("children") or {}
    if kids.get("items"):
        out += ["", f"In it ({kids.get('total') or len(kids['items'])})"]
        for i in kids["items"][:20]:
            name = (i.get("name") or "") + ("/" if i.get("kind") in ("folder", "project", "app") else "")
            out.append("  " + " · ".join(b for b in (name, i.get("who"), i.get("when")) if b))
        if (kids.get("total") or 0) > 20:
            out.append(f"  and {kids['total'] - 20} more")
    return out


def brain(args: list[str]) -> int:
    """`bombadil brain ...`: lines for a person by default, the whole answer with --json."""
    from bombadil.brain import client
    as_json = "--json" in args
    args = [a for a in args if a != "--json"]
    sub, rest = (args[0], args[1:]) if args else ("status", [])
    words = " ".join(rest)
    if hasattr(sys.stdout, "reconfigure"):
        sys.stdout.reconfigure(errors="backslashreplace")   # a file name that is not UTF-8 still prints
    try:
        if sub == "status" and not rest:
            result = client.request("status")
            lines = [result.get("text") or ""]
        elif sub == "why" and rest:
            result = client.request("why", ref=brain_ref(words))
            lines = [str(result)]
        elif sub == "find" and rest:
            result = client.request("search", q=words, limit=20)
            items = (result or {}).get("items") or []
            lines = [" · ".join(b for b in (i.get("title"), i.get("where"), i.get("when")) if b) for i in items]
            if not items and not as_json:
                print(f"Nothing matches “{words}” yet.", file=sys.stderr)
                return 1
        elif sub == "focus" and rest:
            result = client.request("focus", timeout=10.0, ref=brain_ref(words))
            lines = focus_lines(result or {})
        elif sub == "rebuild" and not rest:
            result = client.request("rebuild", timeout=70.0)
            lines = [(result or {}).get("text") or ""]
        else:
            print(__doc__)
            return 2
    except (client.BrainUnavailable, client.BrainError) as e:
        print(str(e), file=sys.stderr)
        return 1
    if as_json:
        print(json.dumps(result, indent=2))
    else:
        for line in lines:
            print(line)
    return 0


def main() -> int:
    if len(sys.argv) < 2:
        print(__doc__)
        return 2
    cmd, args = sys.argv[1], sys.argv[2:]
    if cmd == "ask":
        return talk({"type": "prompt", "text": " ".join(args)})
    elif cmd == "status":
        return talk({"type": "status"}, until="status")
    elif cmd == "stop":
        return send({"type": "stop"})
    elif cmd == "pill":
        return send({"type": "summon"})
    elif cmd == "watch":
        path = Path(args[args.index("--file") + 1]) if "--file" in args else watch.last_turn_file()
        code = watch.show(path, live="--follow" in args)
        watch.wait_for_key()
        return code
    elif cmd == "history":
        for line in watch.history_lines(color=sys.stdout.isatty()):
            print(line)
        watch.wait_for_key()
        return 0
    elif cmd == "undo":
        s = snapshots.Snapshots().undo_last_turn()
        print(f"rolled back to {s.number}; reboot to apply" if s else "nothing to undo")
        return 0 if s else 1
    elif cmd == "brain":
        return brain(args)
    elif cmd == "provider":
        if args[0] not in config.PROVIDERS:
            print(f"unknown provider; choose from {config.PROVIDERS}")
            return 2
        print(f"wrote {config.save_user(args[0])}; restart agentd to apply")
    else:
        print(__doc__)
        return 2
    return 0


if __name__ == "__main__":
    sys.exit(main())
