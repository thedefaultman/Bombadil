#!/usr/bin/env python3
"""bombadil: talk to agentd from a terminal, or manage the system.

  bombadil ask "open the browser"     send a prompt and stream the reply
  bombadil status                      is the agent busy, which provider
  bombadil stop                        end the running turn and everything it started
  bombadil pill                        give the pill the keyboard (Hyprland runs this on a Super tap)
  bombadil watch [--file F] [--follow] every step, command and output of the last (or a) turn
  bombadil history                     recent turns and launcher actions
  bombadil view --file F | -- CMD...   show a file or a command's output in the drawer; Esc closes it
  bombadil undo                        roll back the last turn (reboot to apply)
  bombadil provider claude|codex       switch provider, signing in to it if needed
  bombadil signin [claude|codex]       sign in (again): the page opens in the browser panel
  bombadil open URL                    open a link in the browser panel (bombadil-browser)
  bombadil mail [status]               is Mail running, and how is each account
  bombadil mail accounts               every mail account: id, address, state, unread
  bombadil mail add EMAIL              add an account (finish signing in in the Mail window)
  bombadil mail remove ID              take an account out of Bombadil (the mail stays with its provider)
  bombadil mail views                  the views the Mail window has
  bombadil mail list [VIEW]            the newest mail in a view (all, needs_reply, drafts, acct:ID)
  bombadil mail show [VIEW]            open the Mail window on a view
                                       (nothing sends from here: Send is a button in the Mail window)
"""
import json
import os
import socket
import sys
import time
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parents[1] / "src"))
from bombadil import config, notices, pager, paths, snapshots, watch  # noqa: E402

NO_AGENTD = 3   # follow_setup's exit code when nothing answers on agentd's socket (bombadil-setup looks for it)


def talk(msg: dict, until: str | None = "turn_end"):
    with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as s:
        try:
            s.connect(str(paths.socket_path()))
        except OSError as e:
            print(f"agentd is not running ({e}); it starts with the Hyprland session", file=sys.stderr)
            return 1
        s.sendall((json.dumps(msg) + "\n").encode())
        mine = None  # the turn id agentd gave this prompt; other clients' turns are skipped
        for line in s.makefile("r"):
            ev = json.loads(line)
            if ev.get("type") == "status":
                if until == "status":
                    print(json.dumps(ev))
                    return 0
                continue
            if ev.get("type") == "queued":
                mine = ev["turn"]
                continue
            if ev.get("type") == "local":
                mine = "local"  # a launcher word: answered at once, no turn follows
                continue
            if mine == "local":
                if ev.get("kind") == "local" and ev.get("phase") == "done":
                    print(ev.get("text", ""), file=sys.stdout if ev.get("ok") else sys.stderr)
                    return 0 if ev.get("ok") else 1
                continue
            if ev.get("turn") is not None and ev.get("turn") != mine:
                continue
            if ev.get("kind") in ("text", "output"):
                print(ev["text"])
            elif ev.get("kind") == "tool":
                print(f"  [{ev['name']}] {json.dumps(ev.get('input', {}))[:120]}")
            elif ev.get("kind") == "error":
                print(f"error: {ev['text']}", file=sys.stderr)
                if ev.get("turn") is None:
                    return 1
            if ev.get("kind") == until:
                return 0
    return 0


def follow_setup(msg: dict) -> int:
    """Send a setup message and print the setup line as it changes, until it settles. Exits 0 when
    the AI is ready, 1 when the sign-in ended some other way, NO_AGENTD when agentd does not answer."""
    with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as s:
        try:
            s.connect(str(paths.socket_path()))
        except OSError as e:
            print(f"agentd is not running ({e}); it starts with the Hyprland session", file=sys.stderr)
            return NO_AGENTD
        s.sendall((json.dumps(msg) + "\n").encode())
        said, greeting = None, True
        for line in s.makefile("r"):
            ev = json.loads(line)
            if ev.get("type") != "setup":
                continue
            if greeting:   # how things stood when we connected, before our message was read
                greeting = False
                continue
            if ev.get("line") and ev["line"] != said:
                said = ev["line"]
                print(said, file=sys.stderr if ev.get("tone") == "error" else sys.stdout)
            if ev.get("state") not in ("signing_in", "checking", "offline"):
                return 0 if ev.get("state") == "ready" else 1
    return 1


def send(msg: dict) -> int:
    """Fire one message at agentd and return; for key binds, which must never hang."""
    with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as s:
        s.settimeout(2)
        try:
            s.connect(str(paths.socket_path()))
            s.sendall((json.dumps(msg) + "\n").encode())
            s.shutdown(socket.SHUT_WR)
        except OSError as e:
            print(f"agentd is not running ({e})", file=sys.stderr)
            return 1
        # Closing at once would make agentd's greeting fail and drop the line unread; it hangs
        # up once it has read it.
        try:
            while s.recv(65536):
                pass
        except OSError:
            pass
    return 0


def mail_when(ts) -> str:
    return time.strftime("%Y-%m-%d %H:%M", time.localtime(ts)) if isinstance(ts, (int, float)) else ""


def clean(value, limit: int = 200) -> str:
    """What the service says, as one plain line for a terminal. A name, a subject and an id are other people's
    words, and a terminal does what the escape sequences in them say (clears the screen, retitles the window,
    on some writes to the clipboard); one_line folds those and the newlines, which could forge a row, to spaces."""
    return notices.one_line("" if value is None else value, limit)


def mail_line(m: dict) -> str:
    """One mail as a row: id, when, who, what. Never its text."""
    who = m.get("from") if isinstance(m.get("from"), dict) else {}
    marks = [x for x, on in (("unread", m.get("unread")), ("needs a reply", m.get("needs_reply"))) if on]
    bits = [clean(m.get("id"), 128), mail_when(m.get("ts")), clean(who.get("name") or who.get("email"), 80),
            clean(m.get("subject") or "(no subject)")]
    return "  ".join(b for b in bits if b) + (f"  [{', '.join(marks)}]" if marks else "")


def mail_draft(d: dict) -> str:
    """One draft as a row: id, who it is to, its subject and where it stands (not sent until Send is pressed)."""
    to = ", ".join(clean(a.get("email"), 120) for a in d.get("to") or [] if isinstance(a, dict))
    bits = [clean(d.get("id"), 128), f"to {to}" if to else "to nobody yet", clean(d.get("subject") or "(no subject)")]
    return "  ".join(bits) + f"  [draft, {clean(d.get('state') or 'open', 24)}]"


def mail_account(a: dict) -> str:
    bits = [clean(a.get("id"), 40), clean(a.get("email"), 120), clean(a.get("state"), 24)]
    if isinstance(a.get("unread"), int):
        bits.append(f"{a['unread']} unread")
    if a.get("note"):
        bits.append(clean(a["note"]))
    return "  ".join(b for b in bits if b)


def mail_view(v) -> str:
    if not isinstance(v, dict):
        return clean(v, 80)
    return "  ".join(clean(x, 80) for x in (v.get("id"), v.get("title") or v.get("name"), v.get("count"))
                     if x not in (None, ""))


def mail_items(result, key: str) -> list:
    """The rows of an answer: a list, or {key: [...]} (the service's shape)."""
    rows = result if isinstance(result, list) else (result or {}).get(key) if isinstance(result, dict) else []
    return [r for r in rows or [] if isinstance(r, dict)]


def mail_status_lines(status) -> list[str]:
    text = clean(status.get("text"), 300) if isinstance(status, dict) else ""
    return [text or "Mail is running."] + [mail_account(a) for a in mail_items(status, "accounts")]


def mail_skipped(result) -> list[str]:
    """What a list did not read, and why: an account that is signing in, blocked or in error says so, and
    a list that was cut says there is more. Silence here would read as "nothing in it"."""
    if not isinstance(result, dict):
        return []
    lines = [f"Not read: {mail_account({'id': a.get('account'), 'state': a.get('state'), 'note': a.get('note')})}"
             for a in mail_items(result, "skipped")]
    return lines + (["There is more than this; the Mail window has all of it."] if result.get("more") is True else [])


def mail(args: list[str]) -> int:
    """`bombadil mail ...`: plain lines, and the service's own sentence with exit 1 when it says no. There
    is no send here: a mail goes only by the Send button in the Mail window."""
    from bombadil import launcher
    from bombadil.mail import client
    sub, rest = (args[0], args[1:]) if args else ("status", [])
    if hasattr(sys.stdout, "reconfigure"):
        sys.stdout.reconfigure(errors="backslashreplace")   # a name that is not UTF-8 still prints
    try:
        if sub == "status" and not rest:
            lines = mail_status_lines(client.request("status"))
        elif sub == "accounts" and not rest:
            lines = [mail_account(a) for a in mail_items(client.request("accounts"), "accounts")] \
                or ["No mail account yet."]
        elif sub == "add" and len(rest) == 1:
            result = client.request("add_account", timeout=30.0, email=rest[0])
            lines = [mail_account(result) if isinstance(result, dict) else "Added."]
            if isinstance(result, dict) and result.get("state") == "signin":
                lines.append("Finish signing in in the Mail window.")
        elif sub == "remove" and len(rest) == 1:
            client.request("remove_account", timeout=10.0, id=rest[0])
            lines = [f"Removed {clean(rest[0], 80)}."]
        elif sub == "views" and not rest:
            lines = [mail_view(v) for v in mail_items(client.request("views"), "views")]
        elif sub == "list" and len(rest) <= 1:
            view = rest[0] if rest else "all"
            result = client.request("list", timeout=10.0, view=view, limit=30)
            # The drafts view is a list of drafts; every other view is {"messages": [...], ...}.
            lines = ([mail_draft(d) for d in mail_items(result, "drafts")] if view == "drafts"
                     else [mail_line(m) for m in mail_items(result, "messages")])
            lines += mail_skipped(result)
            lines = lines or ["Nothing here."]
        elif sub == "show" and len(rest) <= 1:
            return mail_show(rest[0] if rest else "all", client, launcher)
        else:
            print(__doc__)
            return 2
    except (client.MailUnavailable, client.MailError) as e:
        print(clean(e, 300), file=sys.stderr)
        return 1
    for line in lines:
        print(line)
    return 0


def mail_show(view: str, client, launcher) -> int:
    """Open the Mail window on a view. With no service it opens all the same, and the window says why it
    is empty (as the typed word "mail" does). From inside an agent's turn only the service is asked: a window
    started here would be a process of that turn, whose Send is refused, so agentd, which hears the service's
    "show", opens it (and `mail_show` is the agent's own way)."""
    try:
        launcher.ask_mail_to_show(view=view)
    except client.MailUnavailable:
        pass
    except client.MailError as e:
        print(clean(e, 300), file=sys.stderr)
        return 1
    if os.environ.get("BOMBADIL_TURN"):
        print("Asked Mail to show it. (From inside a turn, agentd opens the window.)")
        return 0
    try:
        launcher.Launcher().open_mail_window()
    except (OSError, RuntimeError) as e:   # the window would not open
        print(f"Could not open Mail: {clean(e, 300)}", file=sys.stderr)
        return 1
    print("Opened Mail.")
    return 0


def main() -> int:
    if len(sys.argv) < 2:
        print(__doc__)
        return 2
    cmd, args = sys.argv[1], sys.argv[2:]
    if cmd == "ask":
        return talk({"type": "prompt", "text": " ".join(args)})
    elif cmd == "status":
        return talk({"type": "status"}, until="status")
    elif cmd == "stop":
        return send({"type": "stop"})
    elif cmd == "pill":
        return send({"type": "summon"})
    elif cmd == "watch":
        path = Path(args[args.index("--file") + 1]) if "--file" in args else watch.last_turn_file()
        return watch.show(path, live="--follow" in args, wait=True)
    elif cmd == "history":
        for line in watch.history_lines(color=sys.stdout.isatty()):
            print(line)
        watch.wait_for_key()
        return 0
    elif cmd == "view":
        return pager.view(args)
    elif cmd == "undo":
        s = snapshots.Snapshots().undo_last_turn()
        print(f"rolled back to {s.number}; reboot to apply" if s else "nothing to undo")
        return 0 if s else 1
    elif cmd == "provider":
        if not args or args[0] not in config.PROVIDERS:
            print(f"unknown provider; choose from {config.PROVIDERS}")
            return 2
        if paths.socket_path().exists():
            return follow_setup({"type": "setup_action", "id": f"provider:{args[0]}"})
        print(f"wrote {config.save_user(args[0])}; it applies when agentd starts")
    elif cmd == "signin":
        if args and args[0] not in config.PROVIDERS:
            print(f"unknown provider; choose from {config.PROVIDERS}")
            return 2
        return follow_setup({"type": "signin", **({"provider": args[0]} if args else {})})
    elif cmd == "mail":
        return mail(args)
    elif cmd == "open":
        if not args:
            print(__doc__)
            return 2
        import subprocess
        return subprocess.run([str(Path(__file__).resolve().parent / "bombadil-browser"), *args]).returncode
    else:
        print(__doc__)
        return 2
    return 0


if __name__ == "__main__":
    sys.exit(main())
