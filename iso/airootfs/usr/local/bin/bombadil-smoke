#!/usr/bin/env bash
# Boot-time smoke test, run by bombadil-smoke.service when the kernel cmdline has `bombadil.smoke`.
# Prints one BOMBADIL-SMOKE line per check to the console (serial, when booted that way) and
# powers the machine off, so a VM run can be judged from its serial log.
set -u
out=/dev/console
say() { echo "BOMBADIL-SMOKE: $*" | tee "$out"; }
ok=0; fail=0
check() { local name=$1; shift; if "$@" >/tmp/smoke.$name.log 2>&1; then say "PASS $name"; ok=$((ok+1)); else say "FAIL $name: $(tail -c 300 /tmp/smoke.$name.log | tr '\n' ' ')"; fail=$((fail+1)); fi; }
wait_for() { local n=$1; shift; for _ in $(seq "$n"); do "$@" && return 0; sleep 1; done; return 1; }
# bombadil.smoke          live checks, then power off
# bombadil.smoke=install  live checks, install to /dev/vda, power off (the host then boots the disk)
# bombadil.smoke=undo     on an installed system: session checks, then an undo round trip over a reboot
mode="$(tr ' ' '\n' < /proc/cmdline | sed -n 's/^bombadil\.smoke=\?//p' | head -1)"
say "START mode=${mode:-live}"

check user-exists id user
check tools-installed bash -c 'command -v Hyprland quickshell python3 chromium agentd bombadil bombadil-app bombadil-os-mcp'
check pyside6-imports python3 -c 'import PySide6.QtQml, PySide6.QtQuick'
check greetd-active wait_for 60 systemctl is-active --quiet greetd
check hyprland-running wait_for 120 pgrep -x Hyprland
uid=$(id -u user 2>/dev/null || echo 1000)
run="/run/user/$uid"
sock="$run/bombadil/agentd.sock"
# Run a command inside the user's Hyprland session.
as_user() {
  sudo -u user env HOME=/home/user XDG_RUNTIME_DIR="$run" \
    HYPRLAND_INSTANCE_SIGNATURE="$(ls "$run/hypr" 2>/dev/null | head -1)" \
    WAYLAND_DISPLAY="$(cd "$run" 2>/dev/null && ls wayland-* 2>/dev/null | grep -v lock | head -1)" "$@"
}
# Call one os-mcp tool the way the agent would.
mcp_call() {
  printf '%s\n' '{"jsonrpc":"2.0","id":1,"method":"initialize","params":{}}' \
    "{\"jsonrpc\":\"2.0\",\"id\":2,\"method\":\"tools/call\",\"params\":{\"name\":\"$1\",\"arguments\":$2}}" \
    | as_user timeout 60 bombadil-os-mcp | tail -1 | tee /dev/stderr | grep -qv '"isError": true'
}
# hyprctl -j WHAT, retried: under software emulation Hyprland's IPC can miss its deadline.
hypr_json() { local o; for _ in 1 2 3 4 5; do o=$(as_user hyprctl -j "$1") && python3 -c 'import json,sys; json.loads(sys.argv[1])' "$o" 2>/dev/null && { printf '%s' "$o"; return 0; }; sleep 2; done; echo "hyprctl $1: $o"; return 1; }
has_client() { hypr_json clients | python3 -c "import json,sys; sys.exit(not any($1 for c in json.load(sys.stdin)))"; }
no_config_errors() { hypr_json configerrors | python3 -c 'import json,sys; e=[x for x in json.load(sys.stdin) if x]; print(e); sys.exit(bool(e))'; }
has_layer() { hypr_json layers | grep -q "$1"; }
special_shown() { hypr_json monitors | grep -q "\"special:$1\""; }
grab() { as_user grim /tmp/smoke.png && test -s /tmp/smoke.png; }
# Ask the host (scripts/test-vm.sh) for a screenshot of the VM screen.
shot() { say "SHOT $1"; sleep "${SHOT_WAIT:-8}"; }
# Ask the host to press keys on the VM's keyboard, over QMP: "meta_l" taps Super, "meta_l+esc"
# is Super+Escape, "b r o w s e r ret" types a word and Enter.
nkeys=0
keys() { nkeys=$((nkeys+1)); say "KEYS $nkeys $*"; sleep "${KEYS_WAIT:-8}"; }
history_has() { as_user bombadil history | grep -q "$1"; }
agentd_send() { as_user python3 -c 'import json, socket, sys; s = socket.socket(socket.AF_UNIX); s.connect(sys.argv[1]); s.sendall((sys.argv[2] + "\n").encode()); s.shutdown(socket.SHUT_WR); s.recv(1 << 20)' "$sock" "$1"; }

check agentd-socket wait_for 90 test -S "$sock"
check quickshell-running wait_for 60 pgrep -x quickshell
check hypr-config-ok no_config_errors
check bar-layer wait_for 30 has_layer bombadil-bar
check agentd-status as_user bombadil status
check claude-cli as_user claude --version
check codex-cli as_user codex --version
check os-mcp-lists-tools bash -c 'printf "%s\n" "{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"tools/list\"}" | timeout 20 bombadil-os-mcp | grep -q show_panel'
shot desktop
check browser-panel mcp_call show_panel '{"name":"browser"}'
check browser-window wait_for 120 has_client 'c["class"]=="bombadil-browser" and c["workspace"]["name"]=="special:browser"'
check browser-shown special_shown browser
shot browser
check browser-hide mcp_call hide_panel '{"name":"browser"}'
qml='import QtQuick\nimport QtQuick.Controls\nimport Bombadil\nAppWindow { title: \"Smoke\"; subtitle: \"generated on the spot\"; Label { text: \"Hello from a native app\"; color: Theme.fg; font: Theme.font } }'
check create-app mcp_call create_app "{\"title\":\"Smoke Test\",\"qml\":\"$qml\"}"
check app-window wait_for 60 has_client 'c["class"]=="bombadil-app-smoke-test" and c["floating"]'
shot app
check screenshot grab

# The pill: a tap on Super gives it the keyboard, a launcher word opens without the model, and
# Super+Escape stops a running turn and everything it started.
keys meta_l
keys b r o w s e r ret
check super-tap-then-launcher wait_for 60 special_shown browser
check launcher-without-model history_has "browser: Opened the browser"
shot launcher-browser
check browser-hide-again mcp_call hide_panel '{"name":"browser"}'
as_user bombadil ask '!sleep 300' >/tmp/smoke.bang.log 2>&1 &
check bang-turn-running wait_for 30 pgrep -f -x "sleep 300"
shot pill-working
keys meta_l+esc
check super-escape-stops wait_for 30 bash -c '! pgrep -f -x "sleep 300"'
check stop-in-history history_has "sleep 300.*Stopped"
check details-drawer agentd_send '{"type": "details"}'
check details-window wait_for 60 has_client 'c["class"]=="bombadil-details" and c["workspace"]["name"]=="special:details"'
shot details

# Coding sessions (dev.py): a shell session on a project starts in its own systemd scope and
# slice with a floating viewer, lives on when that window closes, comes back by name and ends.
# A shell needs no provider login, so this runs on a fresh VM.
viewer=bombadil-session-smoke-shell
unit_active() { as_user systemctl --user list-units --all --no-legend --plain "$1" | grep -q ' active '; }
unit_gone() { ! unit_active "$1"; }
zellij_has() { as_user zellij list-sessions --short --no-formatting 2>/dev/null | grep -qx "$1"; }
zellij_lacks() { ! zellij_has "$1"; }
no_client() { ! has_client "$1"; }
says() { local want=$1; shift; as_user bombadil ask "$*" | tee /dev/stderr | grep -q "$want"; }
hypr_do() { local o; o=$(as_user hyprctl dispatch "$1") && [[ "$o" == "" || "$o" == "ok" ]] || { echo "$o"; return 1; }; }
close_viewer() { hypr_do "hl.dsp.focus({ window = \"class:^($viewer)\$\" })" && hypr_do 'hl.dsp.window.close()'; }
# The viewer is most of the screen, not foot's own 700x500.
viewer_big() { local m c; m=$(hypr_json monitors) && c=$(hypr_json clients) && python3 -c 'import json, sys; m = json.loads(sys.argv[1])[0]; c = [x for x in json.loads(sys.argv[2]) if x["class"] == sys.argv[3]]; print(m["width"], m["height"], [x["size"] for x in c]); sys.exit(not c or c[0]["size"][0] < 0.7 * m["width"] / m.get("scale", 1))' "$m" "$c" "$viewer"; }
make_project() { as_user bash -c 'mkdir -p ~/Projects/smoke && cd ~/Projects/smoke && git init -q && git -c user.name=smoke -c user.email=smoke@localhost commit -q --allow-empty -m start'; }
check dev-tools bash -c 'command -v zellij foot footclient bombadil-signal'
check dev-hooks-parse python3 -c 'import json, tomllib; json.load(open("/etc/claude-code/managed-settings.d/50-bombadil.json")); tomllib.load(open("/etc/codex/requirements.toml", "rb"))'
check dev-linger bash -c 'loginctl show-user user -p Linger --value | grep -qx yes'
check dev-project make_project
check dev-start says "Started shell on Smoke" shell smoke
check dev-zellij wait_for 20 zellij_has bombadil-smoke-shell
check dev-scope wait_for 20 unit_active 'bombadil-dev-smoke-shell-*.scope'
check dev-slice unit_active 'bombadil-dev-smoke.slice'
check dev-window wait_for 60 has_client "c['class']=='$viewer' and c['floating']"
check dev-window-size viewer_big
shot session
check dev-close-window close_viewer
check dev-window-gone wait_for 30 no_client "c['class']=='$viewer'"
check dev-lives-on zellij_has bombadil-smoke-shell
check dev-back-by-name says "Back to shell on Smoke" shell smoke
check dev-window-again wait_for 60 has_client "c['class']=='$viewer'"
check dev-end says "Ended shell on Smoke" end shell smoke
check dev-ended wait_for 20 zellij_lacks bombadil-smoke-shell
check dev-scope-gone wait_for 20 unit_gone 'bombadil-dev-smoke-shell-*.scope'
check dev-in-history history_has "Ended shell on Smoke"


if [[ "$mode" == "install" ]]; then
  check install bash -c 'BOMBADIL_INSTALL_CMDLINE="console=tty0 console=ttyS0,115200 bombadil.smoke=undo" bombadil-install /dev/vda --yes'
fi

if [[ "$mode" == "undo" ]]; then
  phase=/home/user/.bombadil-smoke-phase   # home is not rolled back, so it remembers the phase
  if [[ ! -f "$phase" ]]; then
    check snapshots-available as_user python3 -c 'import sys; sys.path.insert(0, "/usr/share/bombadil/src"); from bombadil import snapshots; sys.exit(not snapshots.Snapshots().available)'
    check snapshot-turn as_user python3 -c 'import sys; sys.path.insert(0, "/usr/share/bombadil/src"); from bombadil import snapshots; print(snapshots.Snapshots().create("turn:1: smoke change"))'
    check change-system bash -c 'echo changed > /etc/bombadil-smoke-marker'
    check undo as_user bombadil undo
    echo 2 > "$phase"; chown user: "$phase"
    say "REBOOT pass=$ok fail=$fail"
    [[ "${BOMBADIL_SMOKE_NO_POWEROFF:-}" ]] || systemctl reboot
    exit 0
  fi
  check undo-applied bash -c '! test -e /etc/bombadil-smoke-marker'
  rm -f "$phase"
fi

say "DONE pass=$ok fail=$fail"
[[ "${BOMBADIL_SMOKE_NO_POWEROFF:-}" ]] || systemctl poweroff
