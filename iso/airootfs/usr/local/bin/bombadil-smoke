#!/usr/bin/env bash
# Boot-time smoke test, run by bombadil-smoke.service when the kernel cmdline has `bombadil.smoke`.
# Prints one BOMBADIL-SMOKE line per check to the console (serial, when booted that way) and
# powers the machine off, so a VM run can be judged from its serial log.
set -u
out=/dev/console
say() { echo "BOMBADIL-SMOKE: $*" | tee "$out"; }
ok=0; fail=0
check() { local name=$1; shift; if "$@" >/tmp/smoke.$name.log 2>&1; then say "PASS $name"; ok=$((ok+1)); else say "FAIL $name: $(tail -c 300 /tmp/smoke.$name.log | tr '\n' ' ')"; fail=$((fail+1)); fi; }
wait_for() { local n=$1; shift; for _ in $(seq "$n"); do "$@" && return 0; sleep 1; done; return 1; }
# bombadil.smoke          live checks, then power off
# bombadil.smoke=install  live checks, install to /dev/vda, power off (the host then boots the disk)
# bombadil.smoke=install-encrypted
#                         the installer alone, with a password (the host types it at GRUB on the next start)
# bombadil.smoke=refresh  on a disk an older Bombadil installed: plant a marker in its home folder, refresh, power off
# bombadil.smoke=undo     on an installed system: its layout, then an undo round trip over a reboot
# bombadil.smoke=refreshed  on a refreshed system: the old home folder is there, the old system is kept aside
mode="$(tr ' ' '\n' < /proc/cmdline | sed -n 's/^bombadil\.smoke=\?//p' | head -1)"
say "START mode=${mode:-live}"

check user-exists id user
check tools-installed bash -c 'command -v Hyprland quickshell python3 chromium agentd bombadil bombadil-app bombadil-os-mcp'
check pyside6-imports python3 -c 'import PySide6.QtQml, PySide6.QtQuick'
check greetd-active wait_for 60 systemctl is-active --quiet greetd
check hyprland-running wait_for 120 pgrep -x Hyprland
uid=$(id -u user 2>/dev/null || echo 1000)
run="/run/user/$uid"
sock="$run/bombadil/agentd.sock"
# Run a command inside the user's Hyprland session.
as_user() {
  sudo -u user env HOME=/home/user XDG_RUNTIME_DIR="$run" \
    HYPRLAND_INSTANCE_SIGNATURE="$(ls "$run/hypr" 2>/dev/null | head -1)" \
    WAYLAND_DISPLAY="$(cd "$run" 2>/dev/null && ls wayland-* 2>/dev/null | grep -v lock | head -1)" "$@"
}
# Call one os-mcp tool the way the agent would.
mcp_call() {
  printf '%s\n' '{"jsonrpc":"2.0","id":1,"method":"initialize","params":{}}' \
    "{\"jsonrpc\":\"2.0\",\"id\":2,\"method\":\"tools/call\",\"params\":{\"name\":\"$1\",\"arguments\":$2}}" \
    | as_user timeout 60 bombadil-os-mcp | tail -1 | tee /dev/stderr | grep -qv '"isError": true'
}
# hyprctl -j WHAT, retried: under software emulation Hyprland's IPC can miss its deadline.
hypr_json() { local o; for _ in 1 2 3 4 5; do o=$(as_user hyprctl -j "$1") && python3 -c 'import json,sys; json.loads(sys.argv[1])' "$o" 2>/dev/null && { printf '%s' "$o"; return 0; }; sleep 2; done; echo "hyprctl $1: $o"; return 1; }
has_client() { hypr_json clients | python3 -c "import json,sys; sys.exit(not any($1 for c in json.load(sys.stdin)))"; }
no_config_errors() { hypr_json configerrors | python3 -c 'import json,sys; e=[x for x in json.load(sys.stdin) if x]; print(e); sys.exit(bool(e))'; }
# A virtual display runs at 1920x1080, not at the 640x480 QEMU's EDID can report as preferred.
virtual_display_size() { hypr_json monitors | python3 -c 'import json,sys; m=[x for x in json.load(sys.stdin) if x["name"].startswith("Virtual-")]; print([(x["name"], x["width"], x["height"]) for x in m]); sys.exit(any((x["width"], x["height"]) != (1920, 1080) for x in m))'; }
# A real sound output: not just PipeWire's "Dummy Output", which it makes when there is no card or
# no ALSA plugin to read one.
audio_sink() { as_user wpctl status | sed -n '/Sinks:/,/Sources:/p' | grep -E '[0-9]+\. ' | grep -v "Dummy Output" | grep -q .; }
# Every generated app card sits at its own spot (a second one does not hide the first).
apps_apart() { hypr_json clients | python3 -c 'import json,sys; a=[tuple(c["at"]) for c in json.load(sys.stdin) if c["class"].startswith("bombadil-app-") and c["floating"]]; print(a); sys.exit(len(a) < 2 or len(set(a)) != len(a))'; }
has_layer() { hypr_json layers | grep -q "$1"; }
special_shown() { hypr_json monitors | grep -q "\"special:$1\""; }
active_is() { hypr_json activewindow | python3 -c 'import json,sys; sys.exit(json.load(sys.stdin).get("class") != sys.argv[1])' "$1"; }
# No details window and no drawer showing (a failed hyprctl never counts as gone).
drawer_gone() {
  local c m; c=$(hypr_json clients) && m=$(hypr_json monitors) || return 1
  python3 -c 'import json,sys; c, m = json.loads(sys.argv[1]), json.loads(sys.argv[2]); sys.exit(any(x["class"] == "bombadil-details" for x in c) or any((x.get("specialWorkspace") or {}).get("name") == "special:details" for x in m))' "$c" "$m"
}
grab() { as_user grim /tmp/smoke.png && test -s /tmp/smoke.png; }
# Ask the host (scripts/test-vm.sh) for a screenshot of the VM screen.
shot() { say "SHOT $1"; sleep "${SHOT_WAIT:-8}"; }
# Ask the host to press keys on the VM's keyboard, over QMP: "meta_l" taps Super, "meta_l+esc"
# is Super+Escape, "b r o w s e r ret" types a word and Enter.
nkeys=0
keys() { nkeys=$((nkeys+1)); say "KEYS $nkeys $*"; sleep "${KEYS_WAIT:-8}"; }
history_has() { as_user bombadil history | grep -q "$1"; }
# Launcher actions read "  HH:MM  <word you typed>: <what it did>". Match the word at the start of
# the line, so "open the browser: Opened the browser." from an earlier test cannot stand in for it.
launcher_done() { as_user bombadil history | grep -Ec "^ +[0-9]{2}:[0-9]{2} +$1: $2"; }
launcher_ran() { [[ $(launcher_done "$1" "$2") -gt $3 ]]; }
agentd_send() { as_user python3 -c 'import json, socket, sys; s = socket.socket(socket.AF_UNIX); s.connect(sys.argv[1]); s.sendall((sys.argv[2] + "\n").encode()); s.shutdown(socket.SHUT_WR); s.recv(1 << 20)' "$sock" "$1"; }

check agentd-socket wait_for 90 test -S "$sock"
check quickshell-running wait_for 60 pgrep -x quickshell
check hypr-config-ok no_config_errors
check bar-layer wait_for 30 has_layer bombadil-bar
check virtual-display-size virtual_display_size
check audio-output wait_for 60 audio_sink
check pacman-mirror grep -q '^Server = ' /etc/pacman.d/mirrorlist
check agentd-status as_user bombadil status
check claude-cli as_user claude --version
check codex-cli as_user codex --version
check os-mcp-lists-tools bash -c 'printf "%s\n" "{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"tools/list\"}" | timeout 20 bombadil-os-mcp | grep -q show_panel'
shot desktop
check browser-panel mcp_call show_panel '{"name":"browser"}'
check browser-window wait_for 120 has_client 'c["class"]=="bombadil-browser" and c["workspace"]["name"]=="special:browser"'
check browser-shown special_shown browser
shot browser
check browser-hide mcp_call hide_panel '{"name":"browser"}'
qml='import QtQuick\nimport QtQuick.Controls\nimport Bombadil\nAppWindow { title: \"Smoke\"; subtitle: \"generated on the spot\"; Label { text: \"Hello from a native app\"; color: Theme.fg; font: Theme.font } }'
check create-app mcp_call create_app "{\"title\":\"Smoke Test\",\"qml\":\"$qml\"}"
check app-window wait_for 60 has_client 'c["class"]=="bombadil-app-smoke-test" and c["floating"]'
shot app
check create-second-app mcp_call create_app "{\"title\":\"Smoke Two\",\"qml\":\"$qml\"}"
check second-app-window wait_for 60 has_client 'c["class"]=="bombadil-app-smoke-two" and c["floating"]'
check apps-have-own-spots wait_for 30 apps_apart
check screenshot grab

# The pill: a tap on Super gives it the keyboard, a launcher word opens without the model, and
# Super+Escape stops a running turn and everything it started.
before=$(launcher_done browser "Opened the browser")
keys meta_l
keys b r o w s e r ret
check super-tap-then-launcher wait_for 60 special_shown browser
check launcher-without-model wait_for 30 launcher_ran browser "Opened the browser" "$before"
shot launcher-browser
check browser-hide-again mcp_call hide_panel '{"name":"browser"}'
# Alt+Space opens the pill too, for hosts that keep Super.
before=$(launcher_done browser "Opened the browser")
keys alt+spc
keys b r o w s e r ret
check alt-space-then-launcher wait_for 60 launcher_ran browser "Opened the browser" "$before"
check browser-hide-third mcp_call hide_panel '{"name":"browser"}'
as_user bombadil ask '!sleep 300' >/tmp/smoke.bang.log 2>&1 &
check bang-turn-running wait_for 30 pgrep -f -x "sleep 300"
shot pill-working
keys meta_l+esc
check super-escape-stops wait_for 30 bash -c '! pgrep -f -x "sleep 300"'
check stop-in-history history_has "sleep 300.*Stopped"
check details-drawer agentd_send '{"type": "details"}'
check details-window wait_for 60 has_client 'c["class"]=="bombadil-details" and c["workspace"]["name"]=="special:details"'
# The drawer takes the keyboard as it slides in, and every way out closes it: Esc in the
# drawer, Details again, and Esc in the pill.
check details-has-keyboard wait_for 30 active_is bombadil-details
shot details
keys esc
check details-esc-closes wait_for 30 drawer_gone
check details-reopen agentd_send '{"type": "details"}'
check details-reopen-shown wait_for 60 active_is bombadil-details
check details-again agentd_send '{"type": "details"}'
check details-again-closes wait_for 30 drawer_gone
check details-third agentd_send '{"type": "details"}'
check details-third-shown wait_for 60 active_is bombadil-details
keys meta_l
keys esc
check pill-esc-closes-details wait_for 30 drawer_gone
shot details-closed


# Signing in (the live system has no provider picked and no login). agentd asks which AI in the
# pill; a pick starts that CLI's own login with its page in the browser panel. Claude and Codex
# get as far as their real page (or "No internet", when the VM has none), then are called off;
# the whole round trip runs against fake_signin.py, a stand-in login on localhost.
# setup_is STATES [LINE-REGEX [PROVIDER [PHASE [VIEW]]]]: agentd's setup line is in one of STATES
# (a,b) and matches the rest. It prints what it saw: "state provider phase view | line".
setup_is() {
  as_user python3 - "$sock" "$@" <<'PY'
import json, re, socket, sys
sock, states = sys.argv[1], sys.argv[2].split(",")
want = (sys.argv[3:] + ["", "", "", ""])[:4]
s = socket.socket(socket.AF_UNIX); s.settimeout(30); s.connect(sock)
for raw in s.makefile():
    m = json.loads(raw)
    if m.get("type") == "setup":
        break
print(m.get("state"), m.get("provider"), m.get("phase"), m.get("view"), "|", m.get("line"), flush=True)
ok = (m.get("state") in states and re.search(want[0], m.get("line") or "") is not None
      and all(not w or m.get(k) == w for w, k in zip(want[1:], ("provider", "phase", "view"))))
sys.exit(0 if ok else 1)
PY
}
not_checking() { ! setup_is checking; }
# cdp_tab REGEX: a tab in the panel's Chromium has an address that matches.
cdp_tab() { python3 -c 'import json, re, sys, urllib.request as u
t = json.load(u.build_opener(u.ProxyHandler({})).open("http://127.0.0.1:9222/json/list", timeout=20))
print([x.get("url") for x in t]); sys.exit(not any(re.search(sys.argv[1], x.get("url", "")) for x in t if x.get("type") == "page"))' "$1"; }
panel_away() { ! special_shown browser; }
gone() { ! pgrep -u user -f "$1"; }
# restart_agentd [VAR=value...]: agentd again, in this environment, its words in /tmp/smoke.agentd.log.
restart_agentd() {
  pkill -u user -f 'bin/agentd'; wait_for 20 gone 'bin/agentd' || return 1
  echo "--- agentd $*" >>/tmp/smoke.agentd.log
  as_user env "$@" setsid -f agentd >>/tmp/smoke.agentd.log 2>&1 </dev/null
  wait_for 60 test -S "$sock" && wait_for 90 not_checking
}
page_or_offline() { setup_is signing_in "" "$1" waiting || setup_is offline "No internet" "$1"; }
# try_provider NAME PAGE: pick it; its page shows in the panel (or "No internet"); the panel is out.
try_provider() {
  agentd_send "{\"type\": \"setup_action\", \"id\": \"provider:$1\"}" || return 1
  wait_for 240 page_or_offline "$1" || return 1
  if setup_is offline "" "$1"; then echo "no internet in this VM: $1 stops at the offline line"; return 0; fi
  wait_for 90 cdp_tab "$2" && wait_for 60 special_shown browser
}
# called_off PROVIDER: Cancel (Esc) ends the sign-in; the pill says so.
called_off() { agentd_send '{"type": "setup_action", "id": "cancel"}'; wait_for 90 setup_is signed_out,offline 'cancelled|No internet' "${1:-}"; }
port_free() { ! ss -ltn | grep -qE "127\.0\.0\.1:$1\b"; }
held_prompt_ran() { grep -q "echo: hello there" /tmp/smoke.held.log; }
signin_manual() { restart_agentd BOMBADIL_PROVIDER=fake BOMBADIL_FAKE_SIGNIN=manual FAKE_SIGNIN_DELAY=3 && wait_for 180 setup_is ready 'Signed in to Fake'; }
slid_out() { mcp_call hide_panel '{"name":"browser"}' && wait_for 60 setup_is signing_in 'waiting in the browser' fake waiting hidden; }
browser_closed() { pkill -u user -f -- '--class=bombadil-browser'; wait_for 90 setup_is signing_in 'was closed' fake waiting closed; }
page_again() { agentd_send '{"type": "setup_action", "id": "show"}' && wait_for 180 setup_is signing_in 'in the browser' fake waiting shown && wait_for 90 cdp_tab '/authorize'; }
times_out() { restart_agentd BOMBADIL_PROVIDER=fake BOMBADIL_FAKE_SIGNIN=never BOMBADIL_SIGNIN_TIMEOUT=20 && wait_for 240 setup_is signed_out 'timed out' fake; }
offline() { restart_agentd BOMBADIL_PROVIDER=fake BOMBADIL_FAKE_SIGNIN=auto FAKE_SIGNIN_DELAY=2 BOMBADIL_FAKE_SIGNIN_HOST=127.0.0.1:47811 && wait_for 60 setup_is offline 'No internet' fake; }
agentd_log() { tail -n 60 /tmp/smoke.agentd.log | while IFS= read -r l; do say "AGENTD-LOG: $l"; done; }

if [[ "$mode" =~ ^(install|live|)$ ]]; then
  : >/tmp/smoke.agentd.log
  check signin-agentd-starts restart_agentd
  check signin-asks-which-ai setup_is choose 'Which AI should run this computer'
  shot signin-choose
  check signin-codex-page try_provider codex '^https://(auth\.openai\.com|chatgpt\.com)/'
  shot signin-codex
  check signin-codex-called-off called_off codex
  check signin-codex-port-freed wait_for 30 port_free 1455
  check signin-claude-page try_provider claude '^https://(claude\.com|claude\.ai|platform\.claude\.com)/'
  shot signin-claude
  check signin-claude-called-off called_off claude
  check signin-claude-login-ended wait_for 30 gone 'auth login'

  # The round trip, against the stand-in: the page comes back to the CLI by itself, and a prompt
  # asked meanwhile runs after. FAKE_SIGNIN_DELAY keeps the page up long enough for a picture.
  check signin-fake-starts restart_agentd BOMBADIL_PROVIDER=fake BOMBADIL_FAKE_SIGNIN=auto FAKE_SIGNIN_DELAY=40
  check signin-fake-page wait_for 180 cdp_tab '^http://127\.0\.0\.1:[0-9]+/authorize'
  check signin-fake-panel-shown wait_for 90 special_shown browser
  as_user timeout 900 bombadil ask "hello there" >/tmp/smoke.held.log 2>&1 &
  shot signin-page
  check signin-fake-signed-in wait_for 240 setup_is ready 'Signed in to Fake' fake
  check signin-fake-panel-away wait_for 90 panel_away
  shot signin-done
  check signin-held-prompt-ran wait_for 240 held_prompt_ran
  # The printed page, which ends on a code: the code is typed into the CLI for the user.
  rm -f /home/user/.fake-signin
  check signin-code-pasted signin_manual
  # The panel slid out, then the browser closed: the pill says so and brings the page back.
  rm -f /home/user/.fake-signin
  check signin-waits restart_agentd BOMBADIL_PROVIDER=fake BOMBADIL_FAKE_SIGNIN=never
  check signin-waiting wait_for 240 setup_is signing_in 'in the browser' fake waiting shown
  check signin-slid-out slid_out
  shot signin-hidden
  check signin-browser-closed browser_closed
  check signin-page-again page_again
  check signin-esc-cancels called_off fake
  check signin-cli-ended wait_for 30 gone fake_signin.py
  # Nobody finishes it: it times out. No internet: it waits, and signs in once it is back.
  check signin-times-out times_out
  check signin-offline offline
  shot signin-offline
  python3 -m http.server --bind 127.0.0.1 47811 >/dev/null 2>&1 &
  online=$!
  check signin-back-online wait_for 240 setup_is ready 'Signed in to Fake' fake
  kill "$online" 2>/dev/null
  # Back to the session as it booted (no AI picked yet), for what follows.
  rm -f /home/user/.fake-signin /home/user/.config/bombadil/config.toml
  check agentd-restored restart_agentd
  agentd_log
fi

# What the installer must refuse, and what it must do, from the live system (a USB-attached ISO is /dev/sda
# when the host attaches it that way; a CD has no disk, and the check is then skipped).
stick=$(lsblk -dnro NAME,TYPE,TRAN | awk '$2 == "disk" && $3 == "usb" { print "/dev/" $1; exit }')
stick_refused() { local o; o=$(bombadil-install "$stick" --yes 2>&1) && return 1; grep -q 'is the USB stick Bombadil started from' <<<"$o"; }
no_uefi_needed() { [[ -d /sys/firmware/efi ]]; }

cmdline_installed="console=tty0 console=ttyS0,115200 bombadil.smoke=undo"

if [[ "$mode" == "install" ]]; then
  [[ -z "$stick" ]] || check install-refuses-the-stick stick_refused
  check install bash -c "BOMBADIL_INSTALL_CMDLINE='$cmdline_installed' bombadil-install /dev/vda --yes"
fi

if [[ "$mode" == "install-encrypted" ]]; then
  check booted-in-uefi no_uefi_needed
  [[ -z "$stick" ]] || check install-refuses-the-stick stick_refused
  # What the stick's home folder has: the sign-in comes along; Apps is on the carry list but not in this plan.
  mkdir -p /home/user/.claude /home/user/Apps/demo /home/user/Notes
  echo stick-login >/home/user/.claude/credentials.json; echo x >/home/user/Apps/demo/app.qml; echo x >/home/user/Notes/n.txt
  chown -R user: /home/user/.claude /home/user/Apps /home/user/Notes
  cat >/tmp/smoke-plan.json <<'PLAN'
{"disk": "/dev/vda", "timezone": "Europe/Lisbon", "timezone_source": "detected", "hostname": "smoke-laptop", "keymap": "us",
 "carry": [".claude", ".config/bombadil"]}
PLAN
  check install-encrypted bash -c "BOMBADIL_INSTALL_GRUB_SERIAL=1 BOMBADIL_INSTALL_CMDLINE='$cmdline_installed' \
    bombadil-install --plan /tmp/smoke-plan.json --password-fd 3 3< <(printf '%s\n' 'correct-horse-battery-staple')"
fi

if [[ "$mode" == "refresh" ]]; then
  # The disk was installed by an older Bombadil. Put things in its home folder that a refresh must keep, and
  # things in its system that only belong to it, then refresh.
  plant() {
    local top=/run/smoke-top
    mkdir -p "$top"
    mount -o subvolid=5 /dev/vda2 "$top" || return 1
    echo planted >"$top/@home/user/.bombadil-refresh-marker"
    mkdir -p "$top/@home/user/.claude" "$top/@home/user/Projects/demo"
    echo home-login >"$top/@home/user/.claude/credentials.json"
    echo code >"$top/@home/user/Projects/demo/main.py"
    echo old-machine >"$top/@/etc/hostname"
    echo old-system >"$top/@/etc/bombadil-old-marker"
    chown -R 1000:1000 "$top/@home/user/.claude" "$top/@home/user/Projects" "$top/@home/user/.bombadil-refresh-marker"
    umount "$top"
  }
  check refresh-plant plant
  # The stick has a sign-in of its own, which must not replace the home folder's.
  mkdir -p /home/user/.claude; echo stick-login >/home/user/.claude/credentials.json; chown -R user: /home/user/.claude
  check refresh-runs bash -c "BOMBADIL_INSTALL_CMDLINE='console=tty0 console=ttyS0,115200 bombadil.smoke=refreshed' bombadil-install --refresh /dev/vda --yes"
fi

# The shape of an installed disk (layout 1), from inside the installed system.
layout_checks() {
  local enc
  enc=$(python3 -c 'import json; print(json.load(open("/var/lib/bombadil/install.json"))["encrypted"])' 2>/dev/null)
  check layout-record python3 -c 'import json; d=json.load(open("/var/lib/bombadil/install.json")); assert d["layout"] == 1, d'
  mount_is() { findmnt -no FSTYPE,OPTIONS "$1" | grep -Eq "^$2 .*subvol=/$3(,|\$)"; }
  check layout-root mount_is / btrfs @
  check layout-home mount_is /home btrfs @home
  check layout-snapshots mount_is /.snapshots btrfs @snapshots
  check layout-log mount_is /var/log btrfs @log
  check layout-pkg mount_is /var/cache/pacman/pkg btrfs @pkg
  check layout-efi bash -c '[[ "$(findmnt -no FSTYPE /efi)" == vfat ]]'
  check layout-boot-in-root bash -c '! mountpoint -q /boot && test -s /boot/vmlinuz-linux && test -s /boot/initramfs-linux.img && test -s /boot/initramfs-linux-fallback.img'
  check layout-grub-on-efi bash -c 'test -s /efi/EFI/BOOT/BOOTX64.EFI && test -s /efi/grub/grub.cfg && grep -q "/@/boot/vmlinuz-linux" /efi/grub/grub.cfg'
  check layout-snapper bash -c 'snapper list-configs | grep -qw root && snapper list-configs | grep -qw home && snapper -c root get-config | grep -Eq "NUMBER_LIMIT +\| +30"'
  check layout-home-subvolumes bash -c 'for d in .cache .claude .codex .config/chromium Projects; do btrfs subvolume show "/home/user/$d" >/dev/null || exit 1; done'
  check layout-time-sync systemctl is-enabled systemd-timesyncd
  if [[ "$enc" == True ]]; then
    check layout-encrypted bash -c 'cryptsetup status root | grep -q "type: *LUKS2"'
    check layout-three-ways-in bash -c 'dev=$(cryptsetup status root | awk "/device:/ {print \$2}"); [[ "$(cryptsetup luksDump "$dev" | grep -cE "^ +[0-9]+: luks2")" == 3 ]]'
    check layout-key-in-initramfs bash -c 'lsinitcpio /boot/initramfs-linux.img | grep -q etc/cryptsetup-keys.d/root.key'
    check layout-recovery-key-waits bash -c 'test "$(stat -c %a /var/lib/bombadil/recovery-key)" = 600'
    check layout-record-encrypted python3 -c 'import json; d=json.load(open("/var/lib/bombadil/install.json")); assert d["encrypted"] and d["recovery_key_pending"] and d["timezone_source"] == "detected" and d["timezone"] == "Europe/Lisbon", d'
    check layout-hostname bash -c '[[ "$(cat /etc/hostname)" == smoke-laptop ]]'
    check layout-carry-list bash -c 'test "$(cat /home/user/.claude/credentials.json)" = stick-login && test ! -e /home/user/Apps && test ! -e /home/user/Notes'
  fi
}

if [[ "$mode" == "undo" ]]; then
  phase=/home/user/.bombadil-smoke-phase   # home is not rolled back, so it remembers the phase
  if [[ ! -f "$phase" ]]; then
    check grub-menu-hidden grep -q '^GRUB_TIMEOUT_STYLE=hidden' /etc/default/grub
    layout_checks
    check snapshots-available as_user python3 -c 'import sys; sys.path.insert(0, "/usr/share/bombadil/src"); from bombadil import snapshots; sys.exit(not snapshots.Snapshots().available)'
    check snapshot-turn as_user python3 -c 'import sys; sys.path.insert(0, "/usr/share/bombadil/src"); from bombadil import snapshots; print(snapshots.Snapshots().create("turn:1: smoke change"))'
    check restore-point-has-a-kernel bash -c 'n=$(snapper -c root list --columns number | tail -n 1 | tr -d " "); test -s "/.snapshots/$n/snapshot/boot/vmlinuz-linux"'
    check change-system bash -c 'echo changed > /etc/bombadil-smoke-marker'
    check undo as_user bombadil undo
    echo 2 > "$phase"; chown user: "$phase"
    say "REBOOT pass=$ok fail=$fail"
    [[ "${BOMBADIL_SMOKE_NO_POWEROFF:-}" ]] || systemctl reboot
    exit 0
  fi
  check undo-applied bash -c '! test -e /etc/bombadil-smoke-marker'
  # The kernel that started is the one that goes with these modules: a restore point holds both.
  check undo-kernel-matches-modules bash -c 'test -d "/usr/lib/modules/$(uname -r)" && modinfo -k "$(uname -r)" btrfs >/dev/null'
  check undo-layout-kept bash -c 'findmnt -no OPTIONS / | grep -Eq "subvol=/@(,|$)" && test -s /boot/vmlinuz-linux'
  rm -f "$phase"
fi

if [[ "$mode" == "refreshed" ]]; then
  layout_checks
  check refresh-kept-the-home-folder bash -c 'test "$(cat /home/user/.bombadil-refresh-marker)" = planted && test "$(cat /home/user/Projects/demo/main.py)" = code'
  check refresh-kept-the-sign-in bash -c 'test "$(cat /home/user/.claude/credentials.json)" = home-login'
  check refresh-home-is-the-users bash -c 'test "$(stat -c %u /home/user/.bombadil-refresh-marker)" = 1000 && test "$(stat -c %u /home/user)" = 1000'
  check refresh-kept-the-computer-name bash -c 'test "$(cat /etc/hostname)" = old-machine'
  check refresh-is-the-new-system bash -c '! test -e /etc/bombadil-old-marker'
  check refresh-old-system-kept bash -c 'top=$(mktemp -d); mount -o subvolid=5 "$(findmnt -no SOURCE / | sed "s/\[.*//")" "$top" && ls -d "$top"/@.before-refresh-* >/dev/null && test -f "$top"/@.before-refresh-*/etc/bombadil-old-marker && test -s "$top"/@.before-refresh-*/boot/vmlinuz-linux; r=$?; umount "$top"; exit $r'
  check refresh-record python3 -c 'import json; d=json.load(open("/var/lib/bombadil/install.json")); assert d["mode"] == "refresh" and d["kept_aside"], d'
  check refresh-home-restore-points bash -c 'snapper -c home list >/dev/null'
  # Put the old system back: the same GRUB then starts it, which the host sees as that system's own session coming up.
  phase=/home/user/.bombadil-smoke-phase
  if [[ ! -f "$phase" ]]; then
    check refresh-undo bombadil-rollback refresh
    echo 2 > "$phase"; chown user: "$phase"
    say "REBOOT pass=$ok fail=$fail"
    [[ "${BOMBADIL_SMOKE_NO_POWEROFF:-}" ]] || systemctl reboot
    exit 0
  fi
fi

say "DONE pass=$ok fail=$fail"
[[ "${BOMBADIL_SMOKE_NO_POWEROFF:-}" ]] || systemctl poweroff
