#!/usr/bin/env bash
# Boot-time smoke test, run by bombadil-smoke.service when the kernel cmdline has `bombadil.smoke`.
# Prints one BOMBADIL-SMOKE line per check to the console (serial, when booted that way) and
# powers the machine off, so a VM run can be judged from its serial log.
set -u
out=/dev/console
say() { echo "BOMBADIL-SMOKE: $*" | tee "$out"; }
ok=0; fail=0
check() { local name=$1; shift; if "$@" >/tmp/smoke.$name.log 2>&1; then say "PASS $name"; ok=$((ok+1)); else say "FAIL $name: $(tail -c 300 /tmp/smoke.$name.log | tr '\n' ' ')"; fail=$((fail+1)); fi; }
wait_for() { local n=$1; shift; for _ in $(seq "$n"); do "$@" && return 0; sleep 1; done; return 1; }
# bombadil.smoke          live checks, then power off
# bombadil.smoke=install  live checks, install to /dev/vda, power off (the host then boots the disk)
# bombadil.smoke=undo     on an installed system: session checks, then an undo round trip over a reboot
mode="$(tr ' ' '\n' < /proc/cmdline | sed -n 's/^bombadil\.smoke=\?//p' | head -1)"
say "START mode=${mode:-live}"

check user-exists id user
check tools-installed bash -c 'command -v Hyprland quickshell python3 chromium agentd bombadil bombadil-app bombadil-os-mcp'
# `command -v a b` succeeds when either is found, so the brain's two and Mail's three are looked for one by one.
check brain-tools-installed bash -c 'for b in bombadil-brain bombadil-brain-watch; do command -v $b || exit 1; done'
check mail-tools-installed bash -c 'for b in thunderbird bombadil-mail bombadil-mail-host; do command -v $b || exit 1; done'
# Connections: the service and the browser service, the Python they run on, and no mako (the shell owns the notifications).
check connect-tools-installed bash -c 'for b in bombadil-connect bombadil-browserd notify-send wl-copy; do command -v $b || exit 1; done'
check connect-python-installed python3 -c 'import httpx; from mcp import ClientSession'
check mako-is-not-installed bash -c '! command -v mako'
check pyside6-imports python3 -c 'import PySide6.QtQml, PySide6.QtQuick'
check greetd-active wait_for 60 systemctl is-active --quiet greetd
check hyprland-running wait_for 120 pgrep -x Hyprland
uid=$(id -u user 2>/dev/null || echo 1000)
run="/run/user/$uid"
sock="$run/bombadil/agentd.sock"
# Run a command inside the user's Hyprland session.
as_user() {
  sudo -u user env HOME=/home/user XDG_RUNTIME_DIR="$run" \
    HYPRLAND_INSTANCE_SIGNATURE="$(ls "$run/hypr" 2>/dev/null | head -1)" \
    WAYLAND_DISPLAY="$(cd "$run" 2>/dev/null && ls wayland-* 2>/dev/null | grep -v lock | head -1)" "$@"
}
# Call one os-mcp tool the way the agent would.
mcp_call() {
  printf '%s\n' '{"jsonrpc":"2.0","id":1,"method":"initialize","params":{}}' \
    "{\"jsonrpc\":\"2.0\",\"id\":2,\"method\":\"tools/call\",\"params\":{\"name\":\"$1\",\"arguments\":$2}}" \
    | as_user timeout 60 bombadil-os-mcp | tail -1 | tee /dev/stderr | grep -qv '"isError": true'
}
# hyprctl -j WHAT, retried: under software emulation Hyprland's IPC can miss its deadline.
# On failure it prints nothing and puts hyprctl's last answer on stderr, which lands in the check's log.
hypr_json() { local o; for _ in 1 2 3 4 5; do o=$(as_user hyprctl -j "$1") && python3 -c 'import json,sys; json.loads(sys.argv[1])' "$o" 2>/dev/null && { printf '%s' "$o"; return 0; }; sleep 2; done; echo "hyprctl -j $1: $o" >&2; return 1; }
has_client() { local o; o=$(hypr_json clients) && python3 -c "import json,sys; sys.exit(not any($1 for c in json.loads(sys.argv[1])))" "$o"; }
no_config_errors() { local o; o=$(hypr_json configerrors) && python3 -c 'import json,sys; e=[x for x in json.loads(sys.argv[1]) if x]; print(e); sys.exit(bool(e))' "$o"; }
# A virtual display runs at 1920x1080, not at the 640x480 QEMU's EDID can report as preferred.
virtual_display_size() { hypr_json monitors | python3 -c 'import json,sys; m=[x for x in json.load(sys.stdin) if x["name"].startswith("Virtual-")]; print([(x["name"], x["width"], x["height"]) for x in m]); sys.exit(any((x["width"], x["height"]) != (1920, 1080) for x in m))'; }
# A real sound output: not just PipeWire's "Dummy Output", which it makes when there is no card or
# no ALSA plugin to read one.
audio_sink() { as_user wpctl status | sed -n '/Sinks:/,/Sources:/p' | grep -E '[0-9]+\. ' | grep -v "Dummy Output" | grep -q .; }
# Every generated app has its own drawer (a special workspace), so a second never hides the first.
apps_in_own_drawers() { hypr_json clients | python3 -c 'import json,sys; w=[c["workspace"]["name"] for c in json.load(sys.stdin) if c["class"].startswith("bombadil-app-") and c["floating"]]; print(w); sys.exit(len(w) < 2 or len(set(w)) != len(w))'; }
has_layer() { hypr_json layers | grep -q "$1"; }
special_shown() { hypr_json monitors | grep -q "\"special:$1\""; }
active_is() { hypr_json activewindow | python3 -c 'import json,sys; sys.exit(json.load(sys.stdin).get("class") != sys.argv[1])' "$1"; }
# No details window and no drawer showing (a failed hyprctl never counts as gone).
drawer_gone() {
  local c m; c=$(hypr_json clients) && m=$(hypr_json monitors) || return 1
  python3 -c 'import json,sys; c, m = json.loads(sys.argv[1]), json.loads(sys.argv[2]); sys.exit(any(x["class"] == "bombadil-details" for x in c) or any((x.get("specialWorkspace") or {}).get("name") == "special:details" for x in m))' "$c" "$m"
}
grab() { as_user grim /tmp/smoke.png && test -s /tmp/smoke.png; }
# Ask the host (scripts/test-vm.sh) for a screenshot of the VM screen.
shot() { say "SHOT $1"; sleep "${SHOT_WAIT:-8}"; }
# Ask the host to press keys on the VM's keyboard, over QMP: "meta_l" taps Super, "meta_l+esc"
# is Super+Escape, "b r o w s e r ret" types a word and Enter.
nkeys=0
keys() { nkeys=$((nkeys+1)); say "KEYS $nkeys $*"; sleep "${KEYS_WAIT:-8}"; }
history_has() { as_user bombadil history | grep -q "$1"; }
# Launcher actions read "  HH:MM  <word you typed>: <what it did>". Match the word at the start of
# the line, so "open the browser: Opened the browser." from an earlier test cannot stand in for it.
launcher_done() { as_user bombadil history | grep -Ec "^ +[0-9]{2}:[0-9]{2} +$1: $2"; }
launcher_ran() { [[ $(launcher_done "$1" "$2") -gt $3 ]]; }
agentd_send() { as_user python3 -c 'import json, socket, sys; s = socket.socket(socket.AF_UNIX); s.connect(sys.argv[1]); s.sendall((sys.argv[2] + "\n").encode()); s.shutdown(socket.SHUT_WR); s.recv(1 << 20)' "$sock" "$1"; }

check agentd-socket wait_for 90 test -S "$sock"
check quickshell-running wait_for 60 pgrep -x quickshell
# Right after login Hyprland can be too busy to answer for a while (the bar is still starting).
check hypr-config-ok wait_for 6 no_config_errors
check bar-layer wait_for 30 has_layer bombadil-bar
check virtual-display-size virtual_display_size
check audio-output wait_for 60 audio_sink
check pacman-mirror grep -q '^Server = ' /etc/pacman.d/mirrorlist
check agentd-status as_user bombadil status
check claude-cli as_user claude --version
check codex-cli as_user codex --version
check os-mcp-lists-tools bash -c 'printf "%s\n" "{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"tools/list\"}" | timeout 20 bombadil-os-mcp | grep -q show_panel'
shot desktop
check browser-panel mcp_call show_panel '{"name":"browser"}'
check browser-window wait_for 120 has_client 'c["class"]=="bombadil-browser" and c["workspace"]["name"]=="special:browser"'
check browser-shown special_shown browser
shot browser
check browser-hide mcp_call hide_panel '{"name":"browser"}'
qml='import QtQuick\nimport QtQuick.Controls\nimport Bombadil\nAppWindow { title: \"Smoke\"; subtitle: \"generated on the spot\"; Label { text: \"Hello from a native app\"; color: Theme.fg; font: Theme.font } }'
check create-app mcp_call create_app "{\"title\":\"Smoke Test\",\"qml\":\"$qml\"}"
check app-window wait_for 60 has_client 'c["class"]=="bombadil-app-smoke-test" and c["floating"]'
# The app kit: each app slides in from its own drawer, reports its load, and the skill is installed.
app_ok() { as_user bombadil-app status "$1" | python3 -c 'import json,sys; d=json.load(sys.stdin); print(d); sys.exit(not (d.get("ok") and d.get("running")))'; }
# Gone only if hide said so and Hyprland then answered without the drawer (no answer never counts as gone).
app_hidden() { local h o; h=$(as_user bombadil-app hide "$1"); echo "$h"; [[ "$h" == *" hidden" ]] && sleep 2 && o=$(hypr_json monitors) && ! grep -q "\"special:app-$1\"" <<<"$o"; }
open_example() { as_user cp -rT "/usr/share/bombadil/share/skills/bombadil-apps/examples/$1" "/home/user/Apps/$1" && mcp_call open_app "{\"name\":\"$1\"}"; }
check app-shown wait_for 30 special_shown app-smoke-test
check app-status wait_for 30 app_ok smoke-test
check app-skill-installed as_user test -f /home/user/.claude/skills/bombadil-apps/SKILL.md -a -f /home/user/.agents/skills/bombadil-apps/SKILL.md
check mail-skill-installed as_user test -f /home/user/.claude/skills/bombadil-mail/SKILL.md -a -f /home/user/.agents/skills/bombadil-mail/SKILL.md
check connect-skill-installed as_user test -f /home/user/.claude/skills/bombadil-connect/SKILL.md -a -f /home/user/.agents/skills/bombadil-connect/SKILL.md
shot app
check create-second-app mcp_call create_app "{\"title\":\"Smoke Two\",\"qml\":\"$qml\"}"
check second-app-window wait_for 60 has_client 'c["class"]=="bombadil-app-smoke-two" and c["floating"]'
check apps-have-own-drawers wait_for 30 apps_in_own_drawers
check second-app-shown wait_for 30 special_shown app-smoke-two
check app-hide app_hidden smoke-two
for ex in memory password-manager; do
  [[ -d "/usr/share/bombadil/share/skills/bombadil-apps/examples/$ex" ]] || continue
  check "example-$ex" open_example "$ex"
  check "example-$ex-shown" wait_for 60 special_shown "app-$ex"
  check "example-$ex-status" wait_for 30 app_ok "$ex"
  shot "$ex"
done
check screenshot grab

# Pictures from the machine: each is captured from this machine, reaches the bar (agentd says a bar
# was there to draw it) and comes back as words. How long it took goes in the log: a capture over
# 500 ms on real hardware is a finding, not a failure.
picture() {
  local t0 out args="{\"kind\":\"$1\"}"
  [[ -n "${2:-}" ]] && args="{\"kind\":\"$1\",\"target\":\"$2\"}"
  t0=$(date +%s%N)
  out=$(printf '%s\n' '{"jsonrpc":"2.0","id":1,"method":"initialize","params":{}}' \
    "{\"jsonrpc\":\"2.0\",\"id\":2,\"method\":\"tools/call\",\"params\":{\"name\":\"system_map\",\"arguments\":$args}}" \
    | as_user timeout 60 bombadil-os-mcp | tail -1) || return 1
  echo "$1 took $(( ($(date +%s%N) - t0) / 1000000 )) ms: ${out:0:400}" >&2
  grep -q 'shown above the bar' <<<"$out" || return 1
  # The boot is more than its last line (the C-locale tree once read as the root alone).
  [[ "$1" != boot ]] || (( $(grep -oE '\\n[0-9.]+ (s|ms|min): ' <<<"$out" | wc -l) >= 3 ))
}
check os-mcp-lists-pictures bash -c 'printf "%s\n" "{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"tools/list\"}" | timeout 20 bombadil-os-mcp | grep -q system_map'
for kind in network boot disks sound screens; do check "picture-$kind" picture "$kind"; done
check picture-service picture service systemd-logind
shot picture

# The pill: a tap on Super gives it the keyboard, a launcher word opens without the model, and
# Super+Escape stops a running turn and everything it started.
before=$(launcher_done browser "Opened the browser")
keys meta_l
keys b r o w s e r ret
check super-tap-then-launcher wait_for 60 special_shown browser
check launcher-without-model wait_for 30 launcher_ran browser "Opened the browser" "$before"
# A tap that did nothing: was it the bind (Hyprland never ran `bombadil pill`) or the pill? Say which
# in the log: ask for the pill by hand and type the word again.
if ! launcher_ran browser "Opened the browser" "$before"; then
  say "DIAG the tap did nothing; active window: $(hypr_json activewindow | python3 -c 'import json,sys; print(json.load(sys.stdin).get("class"))' 2>&1); release binds: $(hypr_json binds | python3 -c 'import json,sys; print([b["key"] for b in json.load(sys.stdin) if b.get("release")])' 2>&1)"
  as_user bombadil pill; sleep 3
  keys b r o w s e r ret
  if wait_for 30 launcher_ran browser "Opened the browser" "$before"; then say "DIAG by hand the pill took the word: the Super bind did not fire"
  else say "DIAG by hand the pill did not take the word either"; fi
fi
shot launcher-browser
check browser-hide-again mcp_call hide_panel '{"name":"browser"}'
# Alt+Space opens the pill too, for hosts that keep Super.
before=$(launcher_done browser "Opened the browser")
keys alt+spc
keys b r o w s e r ret
check alt-space-then-launcher wait_for 60 launcher_ran browser "Opened the browser" "$before"
check browser-hide-third mcp_call hide_panel '{"name":"browser"}'
as_user bombadil ask '!sleep 300' >/tmp/smoke.bang.log 2>&1 &
check bang-turn-running wait_for 30 pgrep -f -x "sleep 300"
shot pill-working
keys meta_l+esc
check super-escape-stops wait_for 30 bash -c '! pgrep -f -x "sleep 300"'
check stop-in-history history_has "sleep 300.*Stopped"
check details-drawer agentd_send '{"type": "details"}'
check details-window wait_for 60 has_client 'c["class"]=="bombadil-details" and c["workspace"]["name"]=="special:details"'
# The drawer takes the keyboard as it slides in, and every way out closes it: Esc in the
# drawer, Details again, and Esc in the pill.
check details-has-keyboard wait_for 30 active_is bombadil-details
shot details
keys esc
check details-esc-closes wait_for 30 drawer_gone
check details-reopen agentd_send '{"type": "details"}'
check details-reopen-shown wait_for 60 active_is bombadil-details
check details-again agentd_send '{"type": "details"}'
check details-again-closes wait_for 30 drawer_gone
check details-third agentd_send '{"type": "details"}'
check details-third-shown wait_for 60 active_is bombadil-details
keys meta_l
keys esc
check pill-esc-closes-details wait_for 30 drawer_gone
shot details-closed

# A click on a box in a picture that names a service opens it in the same drawer, in the viewer
# (bombadil view, which needs no pager on the image), and one Esc puts it away.
check open-unit agentd_send '{"type": "open", "kind": "unit", "value": "systemd-logind.service"}'
check open-unit-window wait_for 60 has_client 'c["class"]=="bombadil-details" and c["workspace"]["name"]=="special:details"'
check open-unit-has-keyboard wait_for 30 active_is bombadil-details
shot open-unit
keys esc
check open-unit-esc-closes wait_for 30 drawer_gone

# Mail (docs/MAIL.md): Thunderbird is the engine, kept unseen by bombadil-mail, whose user unit starts at
# login. The live system has no mail account, so what needs mail runs the service on its fake engine (sample
# mailboxes, a new mail every few seconds) in the unit's place, then puts the unit back. The fake's database
# and attachment folder are scratch ones, so its sample accounts are never in the mail.db the unit's service
# reads next. The press log stays where agentd writes it, which is where the service looks.
mail_unit() { as_user systemctl --user "$@" bombadil-mail.service; }
mail_gone() { ! pgrep -u user -f 'bin/bombadil-mail$' >/dev/null; }
fake_mail() {
  mail_unit stop; wait_for 20 mail_gone || return 1
  rm -rf /tmp/smoke-mail; install -d -o user -g user /tmp/smoke-mail
  as_user env BOMBADIL_MAIL_ENGINE=fake BOMBADIL_MAIL_FAKE_DRIP=4 BOMBADIL_MAIL_DB=/tmp/smoke-mail/mail.db \
    BOMBADIL_MAIL_FILES=/tmp/smoke-mail/files setsid -f bombadil-mail >>/tmp/smoke.mail.log 2>&1 </dev/null
  wait_for 30 test -S "$run/bombadil/mail.sock"
}
restore_mail() {
  pkill -u user -f 'bin/bombadil-mail$'; wait_for 20 mail_gone || return 1
  mail_unit start && wait_for 60 mail_unit is-active --quiet
}
# agentd says new mail from someone known as a notice: wait for one on its own socket.
# notice_from_agentd SOURCE [TEXT]: the first notice of that source, with chips and (when given) TEXT in its line.
notice_from_agentd() {
  as_user python3 - "$sock" "$1" "${2:-}" <<'PY'
import json, socket, sys
s = socket.socket(socket.AF_UNIX); s.settimeout(40); s.connect(sys.argv[1])
for raw in s.makefile():
    m = json.loads(raw)
    if m.get("type") == "notice" and m.get("source") == sys.argv[2]:
        print(m, flush=True)
        sys.exit(0 if m.get("line") and m.get("actions") and sys.argv[3] in m["line"] else 1)
sys.exit(1)
PY
}
mail_notice_from_agentd() { notice_from_agentd mail; }
# The bar has it, and is showing it (the pill's own line must be free for a notice to show).
line_state() { as_user timeout 10 quickshell ipc -p /usr/share/bombadil/shell/shell.qml call line state; }
notice_on_the_line() {
  line_state | python3 -c 'import json,sys; d=json.load(sys.stdin); print(d); sys.exit(not (d["noticeShown"] and any(n["source"] == sys.argv[1] and n["actions"] for n in d["notices"])))' "$1"
}
mail_notice_on_the_line() { notice_on_the_line mail; }
# Windows of class Thunderbird (the Arch package's is org.mozilla.Thunderbird) open on mail-engine, which is never
# shown and never has the keyboard. Both spellings are opened by the check, and every class the window rule's own
# pattern takes is held to it, so a class that matches and landed elsewhere fails as that, not as "no window".
engine_window_hidden() {
  local c m a
  c=$(hypr_json clients) && m=$(hypr_json monitors) && a=$(hypr_json activewindow) || return 1
  python3 -c 'import json,re,sys; c, m, a = (json.loads(x) for x in sys.argv[1:4])
rule = re.compile(r"(?i)(.*\.)?thunderbird.*")
t = [x for x in c if rule.fullmatch(x["class"])]
print([(x["class"], x["workspace"]["name"]) for x in t], a.get("class"))
sys.exit(bool(len({x["class"].lower() for x in t} & {"thunderbird", "org.mozilla.thunderbird"}) < 2
              or any(x["workspace"]["name"] != "special:mail-engine" for x in t)
              or rule.fullmatch(a.get("class", ""))
              or any((x.get("specialWorkspace") or {}).get("name") == "special:mail-engine" for x in m)))' "$c" "$m" "$a"
}
mail_accounts_listed() { as_user bombadil mail accounts | tee /dev/stderr | grep -q maya@acme.example; }
mail_log() { local l; while IFS= read -r l; do say "MAIL-LOG: $l"; done < <(tail -n 30 /tmp/smoke.mail.log); }
check thunderbird-runs as_user timeout 90 thunderbird --version
check mail-unit-enabled mail_unit is-enabled
check mail-unit-active wait_for 60 mail_unit is-active --quiet
# The unit's own service answers on its socket (no account yet: the engine is off, not broken).
check mail-unit-answers wait_for 60 as_user timeout 20 bombadil mail status
if [[ "$mode" != "undo" ]]; then
  : >/tmp/smoke.mail.log
  # Thunderbird's windows map while the pill holds the keyboard (a tap on Super), as they do when the engine
  # starts or a compose window opens under someone typing: "silent" has to leave the keyboard where it is, and
  # the word typed next has to reach the pill (the pill gives the keyboard back after 20 s, so this goes at once).
  before=$(launcher_done browser "Opened the browser")
  { sleep 4; as_user foot --app-id Thunderbird -e sleep 120 & as_user foot --app-id org.mozilla.Thunderbird -e sleep 120 & wait; } >/dev/null 2>&1 &
  keys meta_l
  check mail-engine-window-hidden wait_for 60 engine_window_hidden
  keys b r o w s e r ret
  check mail-engine-window-keeps-the-keyboard wait_for 60 launcher_ran browser "Opened the browser" "$before"
  launcher_ran browser "Opened the browser" "$before" || say "DIAG the word did not reach the pill; active window: $(hypr_json activewindow | python3 -c 'import json,sys; print(json.load(sys.stdin).get("class"))' 2>&1)"
  check mail-engine-browser-hide mcp_call hide_panel '{"name":"browser"}'
  pkill -u user -f '^foot --app-id (org\.mozilla\.)?Thunderbird -e sleep 120$'
  check mail-fake-starts fake_mail
  check mail-status wait_for 30 as_user timeout 20 bombadil mail status
  check mail-accounts-listed wait_for 30 mail_accounts_listed
  check mail-new-mail-is-a-notice mail_notice_from_agentd
  check mail-notice-on-the-line wait_for 40 mail_notice_on_the_line
  shot mail-notice
  before=$(launcher_done mail "Opened Mail")
  check mail-word-opens-window as_user timeout 60 bombadil ask mail
  check mail-launcher-without-model wait_for 30 launcher_ran mail "Opened Mail" "$before"
  check mail-window wait_for 120 has_client 'c["class"]=="bombadil-app-mail" and c["workspace"]["name"]=="special:app-mail"'
  check mail-window-shown wait_for 30 special_shown app-mail
  check mail-window-status wait_for 30 app_ok mail
  shot mail
  check mail-window-hide app_hidden mail
  check mail-unit-restored restore_mail
  mail_log
fi


# Connections (docs/CONNECT.md): bombadil-connect is a system unit with its own user, and what it keeps is closed to
# the person's own processes. The live system has no connection, so what needs one runs the same unit on its fake
# engine (sample messages and tasks) through a drop-in, with its database in a scratch folder of the unit's own
# state directory (the real connect.db never sees a sample); the folder and the drop-in are taken away afterwards.
connect_unit() { systemctl "$@" bombadil-connect.service; }
connect_dropin=/run/systemd/system/bombadil-connect.service.d
fake_connect() {
  install -d "$connect_dropin"
  install -d -o bombadil-connect -g bombadil-connect -m 0700 /var/lib/bombadil-connect/smoke-fake
  printf '[Service]\nEnvironment=BOMBADIL_CONNECT_ENGINE=fake BOMBADIL_CONNECT_STATE=/var/lib/bombadil-connect/smoke-fake\n' >"$connect_dropin/fake.conf"
  systemctl daemon-reload && connect_unit restart && wait_for 30 test -S /run/bombadil-connect/connect.sock
}
restore_connect() {
  rm -rf "$connect_dropin" /var/lib/bombadil-connect/smoke-fake; systemctl daemon-reload
  connect_unit restart && wait_for 60 connect_unit is-active --quiet
}
# connect_says OP EXPRESSION: the service answers the person's own process (not root, not its user) and the
# answer `r` satisfies EXPRESSION.
connect_says() {
  as_user python3 -c 'import sys; sys.path.insert(0, "/usr/share/bombadil/src"); from bombadil.connect import client
r = client.request(sys.argv[1], 5); print(r, flush=True); sys.exit(not eval(sys.argv[2]))' "$1" "$2"
}
browserd_up() {
  as_user python3 -c 'import sys; sys.path.insert(0, "/usr/share/bombadil/src"); from bombadil.browserd import client
r = client.request("status", 5); print(r, flush=True); sys.exit(not isinstance(r.get("up"), bool))'
}
# The directory is its own user's and closed to everyone else, so the person's processes cannot list it. They can still
# `sudo` on this image (sudoers.d/bombadil), so this is what the unit keeps, not yet a wall against an agent that runs as them.
connect_state_closed() { [[ "$(stat -c %U:%a /var/lib/bombadil-connect)" == bombadil-connect:700 ]] && ! as_user ls /var/lib/bombadil-connect; }
# The unit as systemd loaded it, not as the file reads.
connect_hardened() {
  local want key
  for want in User=bombadil-connect NoNewPrivileges=yes ProtectSystem=strict ProtectHome=yes PrivateTmp=yes RuntimeDirectoryMode=0755 MemoryMax=314572800; do
    key=${want%%=*}
    [[ "$(connect_unit show -P "$key")" == "${want#*=}" ]] || { echo "$key is $(connect_unit show -P "$key"), not ${want#*=}"; return 1; }
  done
}
# The shell's NotificationServer is the one owner of the name, whatever a web page or notify-send calls it by, and a
# notification becomes one line with Reply and Open, shown by the bar. notify-send stands in for a page's notification.
notifications_owner_is_the_shell() { as_user busctl --user status org.freedesktop.Notifications | tee /dev/stderr | grep -q '^Comm=quickshell'; }
notification_becomes_a_notice() {
  notice_from_agentd notify "Legal just signed off" >/tmp/smoke.notify.log 2>&1 &
  local listener=$!
  sleep 2   # the listener is connected before the notification is sent
  as_user notify-send -a Teams "Priya Shah" "Legal just signed off" || return 1
  wait_for 8 notice_on_the_line notify || { kill "$listener" 2>/dev/null; cat /tmp/smoke.notify.log; return 1; }
  wait "$listener"; local heard=$?
  cat /tmp/smoke.notify.log; return $heard
}
check connect-user-exists bash -c 'getent passwd bombadil-connect | grep -q nologin'
check connect-unit-enabled connect_unit is-enabled
check connect-unit-active wait_for 60 connect_unit is-active --quiet
check connect-unit-hardened connect_hardened
# No connection yet: the service is up and says so, to a process that is not its own user.
check connect-unit-answers wait_for 60 connect_says status 'r.get("state") == "ok"'
check connect-state-is-closed connect_state_closed
check browserd-unit-enabled as_user systemctl --user is-enabled bombadil-browserd.service
check browserd-unit-active wait_for 60 as_user systemctl --user is-active --quiet bombadil-browserd.service
check browserd-unit-answers wait_for 60 browserd_up
if [[ "$mode" != "undo" ]]; then
  check mako-is-not-running bash -c '! pgrep -x mako'
  check notifications-owner-is-the-shell wait_for 30 notifications_owner_is_the_shell
  check notification-becomes-a-notice notification_becomes_a_notice
  check connect-fake-starts fake_connect
  check connect-status wait_for 30 connect_says status 'r.get("state") == "ok"'
  check connect-connections-listed wait_for 30 connect_says connections 'r["connections"]'
  check connect-messages-listed wait_for 30 connect_says messages 'r["messages"]'
  check connect-unit-restored restore_connect
fi


# Signing in (the live system has no provider picked and no login). agentd asks which AI in the
# pill; a pick starts that CLI's own login with its page in the browser panel. Claude and Codex
# get as far as their real page (or "No internet", when the VM has none), then are called off;
# the whole round trip runs against fake_signin.py, a stand-in login on localhost.
# setup_is STATES [LINE-REGEX [PROVIDER [PHASE [VIEW]]]]: agentd's setup line is in one of STATES
# (a,b) and matches the rest. It prints what it saw: "state provider phase view | line".
setup_is() {
  as_user python3 - "$sock" "$@" <<'PY'
import json, re, socket, sys
sock, states = sys.argv[1], sys.argv[2].split(",")
want = (sys.argv[3:] + ["", "", "", ""])[:4]
s = socket.socket(socket.AF_UNIX); s.settimeout(30); s.connect(sock)
for raw in s.makefile():
    m = json.loads(raw)
    if m.get("type") == "setup":
        break
print(m.get("state"), m.get("provider"), m.get("phase"), m.get("view"), "|", m.get("line"), flush=True)
ok = (m.get("state") in states and re.search(want[0], m.get("line") or "") is not None
      and all(not w or m.get(k) == w for w, k in zip(want[1:], ("provider", "phase", "view"))))
sys.exit(0 if ok else 1)
PY
}
not_checking() { ! setup_is checking; }
# cdp_tab REGEX: a tab in the panel's Chromium has an address that matches.
cdp_tab() { python3 -c 'import json, re, sys, urllib.request as u
t = json.load(u.build_opener(u.ProxyHandler({})).open("http://127.0.0.1:9222/json/list", timeout=20))
print([x.get("url") for x in t]); sys.exit(not any(re.search(sys.argv[1], x.get("url", "")) for x in t if x.get("type") == "page"))' "$1"; }
panel_away() { ! special_shown browser; }
gone() { ! pgrep -u user -f "$1"; }
# restart_agentd [VAR=value...]: agentd again, in this environment, its words in /tmp/smoke.agentd.log.
restart_agentd() {
  pkill -u user -f 'bin/agentd'; wait_for 20 gone 'bin/agentd' || return 1
  echo "--- agentd $*" >>/tmp/smoke.agentd.log
  as_user env "$@" setsid -f agentd >>/tmp/smoke.agentd.log 2>&1 </dev/null
  wait_for 60 test -S "$sock" && wait_for 90 not_checking
}
page_or_offline() { setup_is signing_in "" "$1" waiting || setup_is offline "No internet" "$1"; }
# try_provider NAME PAGE: pick it; its page shows in the panel (or "No internet"); the panel is out.
try_provider() {
  agentd_send "{\"type\": \"setup_action\", \"id\": \"provider:$1\"}" || return 1
  wait_for 240 page_or_offline "$1" || return 1
  if setup_is offline "" "$1"; then echo "no internet in this VM: $1 stops at the offline line"; return 0; fi
  wait_for 90 cdp_tab "$2" && wait_for 60 special_shown browser
}
# called_off PROVIDER: Cancel (Esc) ends the sign-in; the pill says so.
called_off() { agentd_send '{"type": "setup_action", "id": "cancel"}'; wait_for 90 setup_is signed_out,offline 'cancelled|No internet' "${1:-}"; }
port_free() { ! ss -ltn | grep -qE "127\.0\.0\.1:$1\b"; }
held_prompt_ran() { grep -q "echo: hello there" /tmp/smoke.held.log; }
signin_manual() { restart_agentd BOMBADIL_PROVIDER=fake BOMBADIL_FAKE_SIGNIN=manual FAKE_SIGNIN_DELAY=3 && wait_for 180 setup_is ready 'Signed in to Fake'; }
slid_out() { mcp_call hide_panel '{"name":"browser"}' && wait_for 60 setup_is signing_in 'waiting in the browser' fake waiting hidden; }
browser_closed() { pkill -u user -f -- '--class=bombadil-browser'; wait_for 90 setup_is signing_in 'was closed' fake waiting closed; }
page_again() { agentd_send '{"type": "setup_action", "id": "show"}' && wait_for 180 setup_is signing_in 'in the browser' fake waiting shown && wait_for 90 cdp_tab '/authorize'; }
times_out() { restart_agentd BOMBADIL_PROVIDER=fake BOMBADIL_FAKE_SIGNIN=never BOMBADIL_SIGNIN_TIMEOUT=20 && wait_for 240 setup_is signed_out 'timed out' fake; }
offline() { restart_agentd BOMBADIL_PROVIDER=fake BOMBADIL_FAKE_SIGNIN=auto FAKE_SIGNIN_DELAY=2 BOMBADIL_FAKE_SIGNIN_HOST=127.0.0.1:47811 && wait_for 60 setup_is offline 'No internet' fake; }
agentd_log() { tail -n 60 /tmp/smoke.agentd.log | while IFS= read -r l; do say "AGENTD-LOG: $l"; done; }

if [[ "$mode" != "undo" ]]; then
  : >/tmp/smoke.agentd.log
  check signin-agentd-starts restart_agentd
  check signin-asks-which-ai setup_is choose 'Which AI should run this computer'
  shot signin-choose
  check signin-codex-page try_provider codex '^https://(auth\.openai\.com|chatgpt\.com)/'
  shot signin-codex
  check signin-codex-called-off called_off codex
  check signin-codex-port-freed wait_for 30 port_free 1455
  check signin-claude-page try_provider claude '^https://(claude\.com|claude\.ai|platform\.claude\.com)/'
  shot signin-claude
  check signin-claude-called-off called_off claude
  check signin-claude-login-ended wait_for 30 gone 'auth login'

  # The round trip, against the stand-in: the page comes back to the CLI by itself, and a prompt
  # asked meanwhile runs after. FAKE_SIGNIN_DELAY keeps the page up long enough for a picture.
  check signin-fake-starts restart_agentd BOMBADIL_PROVIDER=fake BOMBADIL_FAKE_SIGNIN=auto FAKE_SIGNIN_DELAY=40
  check signin-fake-page wait_for 180 cdp_tab '^http://127\.0\.0\.1:[0-9]+/authorize'
  check signin-fake-panel-shown wait_for 90 special_shown browser
  as_user timeout 900 bombadil ask "hello there" >/tmp/smoke.held.log 2>&1 &
  shot signin-page
  check signin-fake-signed-in wait_for 240 setup_is ready 'Signed in to Fake' fake
  check signin-fake-panel-away wait_for 90 panel_away
  shot signin-done
  check signin-held-prompt-ran wait_for 240 held_prompt_ran
  # The printed page, which ends on a code: the code is typed into the CLI for the user.
  rm -f /home/user/.fake-signin
  check signin-code-pasted signin_manual
  # The panel slid out, then the browser closed: the pill says so and brings the page back.
  rm -f /home/user/.fake-signin
  check signin-waits restart_agentd BOMBADIL_PROVIDER=fake BOMBADIL_FAKE_SIGNIN=never
  check signin-waiting wait_for 240 setup_is signing_in 'in the browser' fake waiting shown
  check signin-slid-out slid_out
  shot signin-hidden
  check signin-browser-closed browser_closed
  check signin-page-again page_again
  check signin-esc-cancels called_off fake
  check signin-cli-ended wait_for 30 gone fake_signin.py
  # Nobody finishes it: it times out. No internet: it waits, and signs in once it is back.
  check signin-times-out times_out
  check signin-offline offline
  shot signin-offline
  python3 -m http.server --bind 127.0.0.1 47811 >/dev/null 2>&1 &
  online=$!
  check signin-back-online wait_for 240 setup_is ready 'Signed in to Fake' fake
  kill "$online" 2>/dev/null
  # Back to the session as it booted (no AI picked yet), for what follows.
  rm -f /home/user/.fake-signin /home/user/.config/bombadil/config.toml
  check agentd-restored restart_agentd
  agentd_log
fi

if [[ "$mode" == "install" ]]; then
  check install bash -c 'BOMBADIL_INSTALL_CMDLINE="console=tty0 console=ttyS0,115200 bombadil.smoke=undo" bombadil-install /dev/vda --yes'
fi

if [[ "$mode" == "undo" ]]; then
  phase=/home/user/.bombadil-smoke-phase   # home is not rolled back, so it remembers the phase
  if [[ ! -f "$phase" ]]; then
    # The brain, where the watcher has btrfs to watch: every save is named by its writer (a
    # turn's file is the machine's, a file you write is yours) and a rename keeps the thing.
    # The watcher and the brain each need a moment, hence wait_for.
    brain_says() { as_user bombadil brain why "$1" | tee /dev/stderr | grep -q "$2"; }
    brain_watching() { as_user bombadil brain status --json | tee /dev/stderr | grep -q '"watching": true'; }
    brain_id() { as_user bombadil brain focus --json "$1" | python3 -c 'import json, sys; print(json.load(sys.stdin)["thing"]["id"])'; }
    same_id() { [[ -n "$brain_before" && "$(brain_id "$1" 2>/dev/null)" == "$brain_before" ]]; }
    check brain-watch-active wait_for 60 systemctl is-active --quiet bombadil-brain-watch
    check brain-service-active wait_for 60 as_user systemctl --user is-active --quiet bombadil-brain
    check brain-status wait_for 90 as_user bombadil brain status
    check brain-watching wait_for 60 brain_watching
    # The writer stays alive a moment after its save, so the watcher names it and its scope: a
    # writer that has exited is named by its nearest live ancestor, which for a turn's own shell
    # is agentd, and for `sudo -u` is root. `ask` waits for the turn to end, so it gets a timeout:
    # a turn that never ends must fail this check, not hang the run.
    check brain-turn-writes as_user timeout 90 bombadil ask '!echo hi > ~/brain-smoke-turn.txt; sleep 2'
    check brain-why-turn wait_for 60 brain_says /home/user/brain-smoke-turn.txt "Made by the machine in turn [0-9]"
    check brain-you-write as_user sh -c 'echo hi > ~/brain-smoke-you.txt; sleep 2'
    check brain-why-you wait_for 60 brain_says /home/user/brain-smoke-you.txt "You made it"
    brain_before=$(wait_for 30 brain_id /home/user/brain-smoke-you.txt 2>/dev/null | tail -1)
    check brain-rename as_user mv /home/user/brain-smoke-you.txt /home/user/brain-smoke-moved.txt
    check brain-rename-keeps-thing wait_for 60 same_id /home/user/brain-smoke-moved.txt
    # The Brain window is an app of the kit (built in, from share/apps): with the kit here it
    # opens from its drawer and loads without errors, on a brain that knows things by now.
    if declare -F app_ok >/dev/null && [[ -f /usr/share/bombadil/share/apps/brain/main.qml ]]; then
      check brain-window mcp_call open_app '{"name":"brain"}'
      check brain-window-shown wait_for 60 special_shown app-brain
      check brain-window-status wait_for 30 app_ok brain
      shot brain
    fi
    check grub-menu-hidden grep -q '^GRUB_TIMEOUT_STYLE=hidden' /etc/default/grub
    check snapshots-available as_user python3 -c 'import sys; sys.path.insert(0, "/usr/share/bombadil/src"); from bombadil import snapshots; sys.exit(not snapshots.Snapshots().available)'
    check snapshot-turn as_user python3 -c 'import sys; sys.path.insert(0, "/usr/share/bombadil/src"); from bombadil import snapshots; print(snapshots.Snapshots().create("turn:1: smoke change"))'
    check change-system bash -c 'echo changed > /etc/bombadil-smoke-marker'
    check undo as_user bombadil undo
    echo 2 > "$phase"; chown user: "$phase"
    say "REBOOT pass=$ok fail=$fail"
    [[ "${BOMBADIL_SMOKE_NO_POWEROFF:-}" ]] || systemctl reboot
    exit 0
  fi
  check undo-applied bash -c '! test -e /etc/bombadil-smoke-marker'
  rm -f "$phase"
fi

say "DONE pass=$ok fail=$fail"
[[ "${BOMBADIL_SMOKE_NO_POWEROFF:-}" ]] || systemctl poweroff
